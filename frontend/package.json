{
  "name": "prompt-ferry-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "openapi-ts": "openapi-ts",
    "generate:api": "bun run openapi-ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsgo --noEmit -p tsconfig.tsgo.json"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.117",
    "@nuxt/icon": "2.3.1",
    "@nuxt/ui": "4.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^8.21.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "echarts": "^6.1.0",
    "markdown-it": "^14.3.0",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@types/markdown-it": "^14.1.2",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "vite": "^8.1.5"
  }
}
