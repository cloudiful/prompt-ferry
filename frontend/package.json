{
  "name": "prompt-ferry-frontend",
  "private": true,
  "version": "1.27.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "openapi-ts": "openapi-ts",
    "generate:api": "bun run openapi-ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsgo --noEmit -p tsconfig.tsgo.json"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.129",
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "4.11.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^9.2.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "echarts": "^6.1.0",
    "markdown-it": "^15.0.1",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "^8.2.2"
  }
}
