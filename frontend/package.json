{
  "name": "prompt-ferry-frontend",
  "private": true,
  "version": "1.42.31",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "openapi-ts": "bun install --no-save --cwd tools/codegen && bun run --cwd tools/codegen generate",
    "generate:api": "bun run openapi-ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:foundation": "vitest run src/react-tests",
    "test:legacy": "bun test --isolate ./tests/theme-first-paint.test.ts ./tests/dev-proxy-scope.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "echarts": "^6.1.0",
    "lucide-react": "1.58.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router": "8.4.0",
    "tailwindcss": "4.3.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
