{
  "name": "prompt-ferry-frontend",
  "private": true,
  "version": "1.42.11",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "openapi-ts": "openapi-ts",
    "generate:api": "bun run openapi-ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsgo --noEmit -p tsconfig.tsgo.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.138",
    "@nuxt/ui": "4.11.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^9.2.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "echarts": "^6.1.0",
    "markdown-it": "15.0.2",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
