async page => {
  const r={id:'R-MCP:secret-payloads',startedAt:new Date().toISOString(),checks:{},failures:[]}
  const control=async(path,body)=>(await fetch('http://127.0.0.1:8789'+path,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)})).json()
  const payloads=[]
  const observe=req=>{if(['PATCH','POST'].includes(req.method())&&/\/admin\/mcp-servers/.test(req.url()))payloads.push(req.postDataJSON())}
  page.on('request',observe)
  try{
    await control('/__fixtures/reset',{})
    await page.context().clearCookies()
    await page.goto('http://127.0.0.1:5171/login')
    await page.evaluate(()=>{localStorage.clear();localStorage.setItem('prompt-ferry:locale','zh-CN')})
    await page.reload()
    await page.getByRole('textbox',{name:/登录名/}).fill('admin')
    await page.getByRole('textbox',{name:/密码/}).fill('fixture-password')
    await page.getByRole('button',{name:'登录',exact:true}).click()
    await page.waitForTimeout(800)
    await page.goto('http://127.0.0.1:5171/mcp')
    await page.waitForTimeout(700)
    await page.getByRole('button',{name:/新增 MCP/}).first().click()
    const d=page.getByRole('dialog').last()
    await d.getByPlaceholder('名称').fill('Secret Semantics MCP')
    await d.getByPlaceholder('http://127.0.0.1:3000/mcp').fill('https://synthetic.example.internal/mcp')
    await d.getByRole('combobox').nth(4).click()
    await page.getByRole('option',{name:/Basic/}).click()
    await d.getByPlaceholder('username',{exact:true}).fill('synthetic-user')
    await d.getByPlaceholder('password',{exact:true}).fill('synthetic-basic-one')
    await d.getByRole('button',{name:'保存',exact:true}).click()
    await page.waitForTimeout(700)
    if(payloads[0]?.basic_password!=='synthetic-basic-one')throw Error('create password mismatch')
    await page.getByRole('combobox',{name:'每页条数',exact:true}).click()
    await page.getByRole('option',{name:'50',exact:true}).click()
    await page.waitForTimeout(500)
    const open=async()=>{await page.locator('table tbody tr').filter({hasText:'Secret Semantics MCP'}).getByRole('button',{name:'编辑',exact:true}).click();return page.getByRole('dialog').last()}
    let edit=await open()
    r.checks.masked=await edit.locator('input[type=password]').inputValue()===''
    await edit.getByRole('button',{name:'保存',exact:true}).click()
    await page.waitForTimeout(700)
    r.checks.keepExact=payloads[1]?.basic_password===''
    edit=await open()
    await edit.locator('input[type=password]').fill('synthetic-basic-two')
    await edit.getByRole('button',{name:'保存',exact:true}).click()
    await page.waitForTimeout(700)
    r.checks.replaceExact=payloads[2]?.basic_password==='synthetic-basic-two'
    if(!r.checks.masked||!r.checks.keepExact||!r.checks.replaceExact)throw Error('basic secret semantics mismatch')
    r.checks.clearNotApplicable='src/worker_admin/types/mcp.rs:296-322: empty/None preserves stored Basic credentials, including switch away from Basic; no clear control.'
    edit=await open()
    await edit.getByRole('button',{name:'代理地址',exact:true}).click()
    await edit.getByRole('combobox',{name:'代理协议'}).click()
    await page.getByRole('option',{name:'http',exact:true}).click()
    await edit.getByRole('textbox',{name:'代理地址',exact:true}).fill('http://synthetic-proxy.internal:7890')
    await edit.getByRole('button',{name:'保存',exact:true}).click()
    await page.waitForTimeout(700)
    r.checks.proxyReplace=payloads[3]?.proxy_url==='http://synthetic-proxy.internal:7890'
    edit=await open()
    await edit.getByRole('button',{name:'保存',exact:true}).click()
    await page.waitForTimeout(700)
    r.checks.proxyKeep=!Object.hasOwn(payloads[4]??{},'proxy_url')
    edit=await open()
    await edit.getByRole('button',{name:'代理地址',exact:true}).click()
    await edit.getByRole('button',{name:'清除已保存代理',exact:true}).click()
    await edit.getByRole('button',{name:'保存',exact:true}).click()
    await page.waitForTimeout(700)
    r.checks.proxyClear=payloads[5]?.proxy_url===''
    if(!r.checks.proxyReplace||!r.checks.proxyKeep||!r.checks.proxyClear)throw Error('proxy payload mismatch')
    edit=await open()
    await edit.getByRole('button',{name:'代理地址',exact:true}).click()
    r.checks.proxyClearState=await edit.getByRole('combobox',{name:'代理协议'}).innerText()==='直连（无代理）'
    if(!r.checks.proxyClearState)throw Error('proxy clear did not roundtrip')
    await page.keyboard.press('Escape')
  }catch(e){r.failures.push(String(e))}finally{page.off('request',observe)}
  r.finishedAt=new Date().toISOString()
  return JSON.stringify(r)
}
