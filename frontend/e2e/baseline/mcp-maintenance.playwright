async page => {
  const control = async (path, body) => (await fetch('http://127.0.0.1:8789'+path,{method:body === undefined?'GET':'POST',headers:{'content-type':'application/json'},body:body === undefined?undefined:JSON.stringify(body)})).json()
  const r={scenario:'R-USAGE-MCP:detail-maintenance',startedAt:new Date().toISOString(),failures:[],checks:{}}
  try {
    await control('/__fixtures/reset',{})
    await page.context().clearCookies()
    await page.goto('http://127.0.0.1:5171/login')
    await page.evaluate(()=>{localStorage.clear();localStorage.setItem('prompt-ferry:locale','zh-CN')})
    await page.reload()
    await page.getByRole('textbox',{name:/登录名/}).fill('admin')
    await page.getByRole('textbox',{name:/密码/}).fill('fixture-password')
    await page.getByRole('button',{name:'登录',exact:true}).click()
    await page.waitForTimeout(900)
    await page.goto('http://127.0.0.1:5171/request-records/mcp')
    await page.waitForTimeout(1200)
    await page.getByRole('button',{name:'记录',exact:true}).click()
    await page.waitForTimeout(700)
    r.checks.initialRows=await page.locator('table tbody tr').count()
    const firstRows=await page.locator('table tbody tr').allInnerTexts()
    await page.getByRole('button',{name:/查看详情|view details/i}).first().click()
    const d=page.getByRole('dialog').last()
    await d.waitFor()
    r.checks.detail=await d.innerText()
    if(!r.checks.detail.includes('请求载荷')||!r.checks.detail.includes('响应载荷')||!r.checks.detail.includes('Fixture prompt text.'))throw Error('detail payload missing')
    await page.keyboard.press('Escape')
    await page.getByRole('button',{name:/下一页|next page/i}).last().click()
    await page.waitForTimeout(500)
    const secondRows=await page.locator('table tbody tr').allInnerTexts()
    const pageRequests=(await control('/__fixtures/log?limit=200')).requests.filter(x=>x.method==='GET'&&x.path==='/api/v1/admin/request-records')
    const lastPage=pageRequests.at(-1)
    r.checks.pagination={query:lastPage?.query,before:firstRows.length,after:secondRows.length,changed:firstRows[0]!==secondRows[0]}
    if(lastPage?.query?.first!=='25'||lastPage?.query?.rows!=='25'||firstRows.length!==25||secondRows.length!==1||!r.checks.pagination.changed)throw Error('MCP record pagination assertion failed')
    await page.getByRole('button',{name:/清除历史|clear history/i}).first().click()
    await page.waitForTimeout(400)
    r.checks.confirm=await page.getByRole('dialog').last().innerText()
    await page.getByRole('dialog').last().getByRole('button',{name:'取消',exact:true}).click()
    const clearWrites=async()=> (await control('/__fixtures/log?limit=200')).requests.filter(x=>x.path?.includes('/request-records/clear')&&x.method==='POST')
    r.checks.cancelWrites=(await clearWrites()).length
    if(r.checks.cancelWrites!==0)throw Error('cancel dispatched clear')
    await page.getByRole('button',{name:'清除历史记录',exact:true}).click()
    await page.getByRole('dialog').last().getByRole('combobox').click()
    await page.getByRole('option',{name:'全部记录',exact:true}).click()
    await page.getByRole('dialog').last().getByRole('checkbox',{name:'全部记录',exact:true}).check()
    await page.getByRole('dialog').last().getByRole('button',{name:'确认清除',exact:true}).click()
    await page.waitForTimeout(1000)
    r.checks.writes=await clearWrites()
    r.checks.after=await page.locator('body').innerText()
    if(r.checks.writes.length!==1)throw Error('expected one clear write')
    if(!r.checks.after.includes('暂无 MCP 调用记录'))throw Error('missing empty state after clear')
  }catch(e){r.failures.push(String(e))}
  r.finishedAt=new Date().toISOString()
  return JSON.stringify(r)
}
