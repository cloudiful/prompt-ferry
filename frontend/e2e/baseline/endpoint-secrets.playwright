async page => {
 const r={id:'R-ENDPOINTS-UPSTREAMS:secret-payloads',startedAt:new Date().toISOString(),checks:{},failures:[]}
 const api=async(path,body)=>(await fetch('http://127.0.0.1:8789'+path,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)})).json()
 const payloads=[]
 const observe=req=>{if(req.method()==='PATCH'&&req.url().includes('/admin/endpoints/'))payloads.push(req.postDataJSON())}
 page.on('request',observe)
 try{
  await api('/__fixtures/reset',{});await page.context().clearCookies();await page.goto('http://127.0.0.1:5171/login');await page.evaluate(()=>{localStorage.clear();localStorage.setItem('prompt-ferry:locale','zh-CN')});await page.reload();await page.getByRole('textbox',{name:/登录名/}).fill('admin');await page.getByRole('textbox',{name:/密码/}).fill('fixture-password');await page.getByRole('button',{name:'登录',exact:true}).click();await page.waitForTimeout(900)
  const open=async()=>{await page.goto('http://127.0.0.1:5171/endpoints/upstreams');await page.waitForTimeout(700);await page.locator('table tbody tr').filter({hasText:'MiniMax Platform China Production'}).getByRole('button',{name:'编辑',exact:true}).click();return page.getByRole('dialog').last()}
  const save=async d=>{await d.getByRole('button',{name:'保存上游节点',exact:true}).click();await page.waitForTimeout(700)}
  let d=await open()
  await save(d)
  r.checks.keep=payloads[0]?.api_keys?.every(k=>k.api_key===null||k.api_key===undefined||k.api_key==='')
  d=await open();await d.getByPlaceholder('留空则保持现有 API key').first().fill('synthetic-upstream-replacement');await save(d)
  r.checks.replace=payloads[1]?.api_keys?.[0]?.api_key==='synthetic-upstream-replacement'
  d=await open();await d.locator('table tbody tr').last().getByRole('button',{name:'删除',exact:true}).click();await save(d)
  r.checks.remove=payloads[2]?.api_keys?.length===1&&payloads[2]?.api_keys?.[0]?.key_label==='primary'
  if(!r.checks.keep||!r.checks.replace||!r.checks.remove)throw Error('API key payload mismatch')
  d=await open();await d.getByRole('button',{name:'端点设置',exact:true}).click()
  await d.getByRole('combobox',{name:'代理协议'}).click();await page.getByRole('option',{name:'http',exact:true}).click();await d.getByRole('textbox',{name:'代理地址',exact:true}).fill('http://synthetic-proxy.internal:7890');await save(d)
  r.checks.proxyReplace=payloads[3]?.proxy_url==='http://synthetic-proxy.internal:7890'
  d=await open();await save(d);r.checks.proxyKeep=!Object.hasOwn(payloads[4]??{},'proxy_url')
  d=await open();await d.getByRole('button',{name:'端点设置',exact:true}).click();await d.getByRole('button',{name:'清除已保存代理',exact:true}).click();await save(d);r.checks.proxyClear=payloads[5]?.proxy_url===''
  if(!r.checks.proxyReplace||!r.checks.proxyKeep||!r.checks.proxyClear)throw Error('endpoint proxy payload mismatch')
  d=await open();await d.getByRole('button',{name:'端点设置',exact:true}).click();r.checks.proxyClearState=await d.getByRole('combobox',{name:'代理协议'}).innerText()==='直连（无代理）';if(!r.checks.proxyClearState)throw Error('endpoint proxy clear did not roundtrip');await page.keyboard.press('Escape')
 }catch(e){r.failures.push(String(e))}finally{page.off('request',observe)}
 r.finishedAt=new Date().toISOString();return JSON.stringify(r)
}
