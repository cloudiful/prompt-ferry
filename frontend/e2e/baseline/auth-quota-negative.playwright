async page => {
 const base='http://127.0.0.1:5171'
 const r={startedAt:new Date().toISOString(),checks:{},failures:[]}
 page.setDefaultTimeout(8000)
 const api=async(path,body)=>(await fetch('http://127.0.0.1:8789'+path,{method:body?'POST':'GET',headers:{'content-type':'application/json'},body:body?JSON.stringify(body):undefined})).json()
 const since=async t=>(await api('/__fixtures/log?limit=500')).requests.filter(x=>Date.parse(x.at)>=t)
 const run=async(name,fn)=>{try{await fn()}catch(e){r.failures.push({name,error:String(e)})}}
 const visit=async()=>{await page.goto(base+'/endpoints/upstreams');await page.waitForTimeout(900)}
 const edit=async()=>{await visit();await page.locator('table tbody tr').filter({hasText:'OpenAI ChatGPT Subscription'}).getByRole('button',{name:'编辑',exact:true}).click();return page.getByRole('dialog').last()}
 await api('/__fixtures/reset',{})
 await page.context().clearCookies();await page.goto(base+'/login');await page.evaluate(()=>{localStorage.clear();localStorage.setItem('prompt-ferry:locale','zh-CN')});await page.reload();await page.getByRole('textbox',{name:/登录名/}).fill('admin');await page.getByRole('textbox',{name:/密码/}).fill('fixture-password');await page.getByRole('button',{name:'登录',exact:true}).click();await page.waitForTimeout(900)
 await run('oauth-negatives',async()=>{
  let d=await edit();await d.getByRole('button',{name:'清除凭据',exact:true}).click();await page.waitForTimeout(500)
  await api('/__fixtures/faults',{pathPrefix:'/api/v1/admin/endpoints/ep-openai-codex/oauth/device',method:'POST',status:500,count:1})
  let t=Date.now();await d.getByRole('button',{name:'开始登录',exact:true}).click();await page.waitForTimeout(600)
  const deviceFailure=await since(t)
  await api('/__fixtures/faults',{pathPrefix:'/api/v1/admin/endpoints/ep-openai-codex/oauth/browser',method:'POST',status:500,count:1})
  t=Date.now();await d.getByRole('button',{name:'获取授权链接',exact:true}).click();await page.waitForTimeout(600)
  const browserFailure=await since(t)
  await api('/__fixtures/faults',{pathPrefix:'/api/v1/admin/endpoints/ep-openai-codex/oauth/device/poll',method:'POST',status:200,delayMs:1600,count:1})
  await d.getByRole('button',{name:'开始登录',exact:true}).click();await page.waitForTimeout(1150)
  await page.keyboard.press('Escape');const dismissalBlocked=await d.isVisible().catch(()=>false)
  await page.goto(base+'/available-models');const closed=!(await d.isVisible().catch(()=>false));t=Date.now();await page.waitForTimeout(3500)
  const afterClose=await since(t)
  d=await edit();const statusText=await d.innerText()
  r.checks.oauth={deviceFailure,browserFailure,dismissalBlocked,closed,afterClose,statusAfterCancel:statusText.includes('未登录'),text:statusText.slice(0,500)}
 })
 await run('quota-list-failure-retry',async()=>{
  await visit()
  await page.locator('table tbody tr').filter({hasText:'MiniMax Platform China Production'}).getByRole('button',{name:'套餐用量',exact:true}).click()
  const d=page.getByRole('dialog').last();await d.getByRole('button',{name:'按键额度历史',exact:true}).click();await page.waitForTimeout(500)
  await api('/__fixtures/faults',{pathPrefix:'/api/v1/admin/endpoints/ep-minimax-cn/quota-observations',method:'GET',status:500,count:1})
  const t=Date.now();await d.getByRole('button',{name:'列表',exact:true}).click();await page.waitForTimeout(900)
  const failed=await since(t)
  r.checks.quota={failed,text:await d.innerText(),buttons:await d.getByRole('button').allTextContents()}
  const retry=d.getByRole('button',{name:/重试|刷新/}).last()
  if(await retry.count()){await retry.click();await page.waitForTimeout(900);r.checks.quota.retry=await since(t)}
 })
 r.finishedAt=new Date().toISOString();return JSON.stringify(r)
}
