async page => {
  const r={id:'R-RELAYS:secret-payloads',startedAt:new Date().toISOString(),checks:{},failures:[]}
  const control=async(path,body)=>(await fetch('http://127.0.0.1:8789'+path,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)})).json()
  const payloads=[]
  const observe=req=>{if(req.method()==='PATCH'&&/\/admin\/relays\//.test(req.url()))payloads.push(req.postDataJSON())}
  page.on('request',observe)
  try{
    await control('/__fixtures/reset',{})
    await page.context().clearCookies()
    await page.goto('http://127.0.0.1:5171/login')
    await page.evaluate(()=>{localStorage.clear();localStorage.setItem('prompt-ferry:locale','zh-CN')})
    await page.reload()
    await page.getByRole('textbox',{name:/登录名/}).fill('admin')
    await page.getByRole('textbox',{name:/密码/}).fill('fixture-password')
    await page.getByRole('button',{name:'登录',exact:true}).click()
    await page.waitForTimeout(800)
    await page.goto('http://127.0.0.1:5171/relays')
    await page.waitForTimeout(700)
    const open=async()=>{await page.locator('table tbody tr').first().getByRole('button',{name:'编辑',exact:true}).click();return page.getByRole('dialog').last()}
    let d=await open()
    const fields=['relay_ca_pem','bridge_encryption_key','client_cert_pem','client_key_pem']
    const names=await d.getByPlaceholder('例如：华东中继 / 公网中继').inputValue()
    r.checks.sameResourceName=Boolean(names)
    await d.getByRole('button',{name:'保存',exact:true}).click()
    await page.waitForTimeout(700)
    r.checks.keepModes=Object.fromEntries(['relay_ca_pem','client_cert_pem','client_key_pem','bridge_encryption_key'].map(k=>[k,payloads[0]?.[k]?.mode??'omitted']))
    d=await open()
    for(let i=0;i<fields.length;i++)await d.locator('textarea').nth(i).fill('synthetic-'+fields[i])
    await d.getByRole('button',{name:'保存',exact:true}).click()
    await page.waitForTimeout(700)
    r.checks.replaceExact=fields.every(k=>payloads[1]?.[k]?.mode==='replace'&&payloads[1]?.[k]?.value==='synthetic-'+k)
    if(!r.checks.replaceExact)throw Error('replace payload mismatch')
    if(!fields.every(k=>payloads[0]?.[k]?.mode==='keep'&&Object.keys(payloads[0][k]).length===1))throw Error('keep payload mismatch')
    d=await open()
    for(let i=0;i<fields.length;i++){
      await d.getByRole('combobox').nth(i+2).click()
      await page.getByRole('option',{name:'清空',exact:true}).click()
    }
    await d.getByRole('button',{name:'保存',exact:true}).click()
    await page.waitForTimeout(700)
    r.checks.clearExact=fields.every(k=>payloads[2]?.[k]?.mode==='clear'&&Object.keys(payloads[2][k]).length===1)
    if(!r.checks.clearExact)throw Error('clear payload mismatch')
    d=await open()
    r.checks.clearedState=await d.getByRole('combobox').allTextContents()
    if(r.checks.clearedState.slice(2).some(v=>v!=='替换'))throw Error('cleared stored flags did not roundtrip')
    await page.keyboard.press('Escape')
  }catch(e){r.failures.push(String(e))}finally{page.off('request',observe)}
  r.finishedAt=new Date().toISOString()
  return JSON.stringify(r)
}
