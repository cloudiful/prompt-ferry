async page => {
 const r={startedAt:new Date().toISOString(),checks:{},failures:[]}
 const payloads=[]
 const writes=[]
 const observe=req=>{if(['PATCH','PUT'].includes(req.method())&&req.url().includes('/settings/')){writes.push({path:new URL(req.url()).pathname,body:req.postDataJSON()});if(req.url().endsWith('/settings/raw-object-store'))payloads.push(req.postDataJSON())}}
 page.on('request',observe)
 const api=async(path,body)=>(await fetch('http://127.0.0.1:8789'+path,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)})).json()
 try{
  await api('/__fixtures/reset',{});await page.context().clearCookies();await page.goto('http://127.0.0.1:5171/login');await page.evaluate(()=>{localStorage.clear();localStorage.setItem('prompt-ferry:locale','zh-CN')});await page.reload();await page.getByRole('textbox',{name:/登录名/}).fill('admin');await page.getByRole('textbox',{name:/密码/}).fill('fixture-password');await page.getByRole('button',{name:'登录',exact:true}).click();await page.waitForTimeout(900)
  await page.goto('http://127.0.0.1:5171/settings/storage');await page.waitForTimeout(700)
  await page.locator('article').getByRole('combobox').click();await page.getByRole('option',{name:/S3/}).click()
  await page.waitForTimeout(300)
  const card=page.locator('article')
  const save=async()=>{await card.getByRole('button',{name:'保存',exact:true}).click();await page.waitForTimeout(600)}
  await save()
  r.checks.storageKeep=['s3_access_key','s3_secret_key'].every(k=>payloads[0]?.[k]?.mode==='keep'&&Object.keys(payloads[0][k]).length===1)
  const secrets=card.locator('input[type=password]')
  await secrets.nth(0).fill('synthetic-access');await secrets.nth(1).fill('synthetic-secret')
  await card.getByRole('textbox',{name:'前缀',exact:true}).fill('retry-prefix/')
  await api('/__fixtures/faults',{pathPrefix:'/api/v1/settings/raw-object-store',method:'PATCH',status:503,count:1,message:'Storage retry fixture'})
  await save()
  r.checks.storageFailureDraft=(await secrets.nth(0).inputValue())==='synthetic-access'&&(await secrets.nth(1).inputValue())==='synthetic-secret'&&(await card.getByRole('textbox',{name:'前缀',exact:true}).inputValue())==='retry-prefix/'
  await save()
  r.checks.storageRetryPayload=JSON.stringify(payloads[1])===JSON.stringify(payloads[2])&&payloads[2]?.s3_access_key?.value==='synthetic-access'&&payloads[2]?.s3_secret_key?.value==='synthetic-secret'
  r.checks.storageSuccessReset=(await secrets.nth(0).inputValue())===''&&(await secrets.nth(1).inputValue())===''
  r.checks.storageClearNotApplicable='SettingsStorageTab.vue:61-64 builds only keep/replace, no clear input/action.'
  if(!r.checks.storageKeep||!r.checks.storageFailureDraft||!r.checks.storageRetryPayload||!r.checks.storageSuccessReset)throw Error('storage secret/failure contract mismatch')
  await page.goto('http://127.0.0.1:5171/settings/cache-alert');await page.waitForTimeout(600)
  const cacheBodies=()=>writes.filter(w=>w.path.endsWith('/cache-alert')).map(w=>w.body)
  await page.getByRole('button',{name:'保存',exact:true}).click();await page.waitForTimeout(600)
  r.checks.cacheKeep=cacheBodies()[0]?.dingtalk_secret===''
  await page.locator('input[type=password]').fill('synthetic-dingtalk')
  await api('/__fixtures/faults',{pathPrefix:'/api/v1/settings/cache-alert',method:'PUT',status:503,count:1,message:'Cache retry fixture'})
  await page.getByRole('button',{name:'保存',exact:true}).click();await page.waitForTimeout(600)
  r.checks.cacheFailureDraft=await page.locator('input[type=password]').inputValue()==='synthetic-dingtalk'
  await page.getByRole('button',{name:'保存',exact:true}).click();await page.waitForTimeout(600)
  r.checks.cacheRetry=JSON.stringify(cacheBodies()[1])===JSON.stringify(cacheBodies()[2])&&cacheBodies()[2]?.dingtalk_secret==='synthetic-dingtalk'
  r.checks.cacheClearNotApplicable='forms/cache-alert.ts:68-69 and generated setCacheAlertSetting contract: blank secret preserves stored value; UI mode is only keep/replace.'
  if(!r.checks.cacheKeep||!r.checks.cacheFailureDraft||!r.checks.cacheRetry)throw Error('cache alert payload/failure mismatch')
  await page.goto('http://127.0.0.1:5171/settings/review');await page.waitForTimeout(600)
  r.checks.review=await page.locator('article').ariaSnapshot()
 }catch(e){r.failures.push(String(e))}finally{page.off('request',observe)}
 r.finishedAt=new Date().toISOString();return JSON.stringify(r)
}
