async page => {
  const api = async (path, body) => (await fetch('http://127.0.0.1:8789'+path,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)})).json()
  const r={scenario:'R-ENDPOINTS-UPSTREAMS:quota-stale',startedAt:new Date().toISOString(),failures:[],checks:{}}
  try {
    await api('/__fixtures/reset',{})
    await api('/__fixtures/quota',{stale:true})
    await page.context().clearCookies()
    await page.goto('http://127.0.0.1:5171/login')
    await page.evaluate(()=>{localStorage.clear();localStorage.setItem('prompt-ferry:locale','zh-CN')})
    await page.reload()
    await page.getByRole('textbox',{name:/登录名/}).fill('admin')
    await page.getByRole('textbox',{name:/密码/}).fill('fixture-password')
    await page.getByRole('button',{name:'登录',exact:true}).click()
    await page.waitForTimeout(900)
    const open=async()=>{
      await page.goto('http://127.0.0.1:5171/endpoints/upstreams')
      await page.waitForTimeout(800)
      await page.locator('table tbody tr').filter({hasText:'MiniMax Platform China Production'}).getByRole('button',{name:'套餐用量',exact:true}).click()
      await page.waitForTimeout(400)
      return page.getByRole('dialog').last()
    }
    let d=await open()
    r.checks.staleText=await d.innerText()
    if(!r.checks.staleText.includes('缓存观测')||!r.checks.staleText.includes('刷新失败，仍显示最近一次成功观测。'))throw Error('stale observation not rendered')
    await api('/__fixtures/quota',{stale:false})
    d=await open()
    r.checks.freshText=await d.innerText()
    if(r.checks.freshText.includes('缓存观测')||r.checks.freshText.includes('刷新失败，仍显示最近一次成功观测。'))throw Error('fresh read retained stale labels')
  }catch(e){r.failures.push(String(e))}
  r.finishedAt=new Date().toISOString()
  return JSON.stringify(r)
}
