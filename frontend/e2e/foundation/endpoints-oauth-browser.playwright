async page => {
  const FIXTURE = 'http://127.0.0.1:8789'
  const report = {
    startedAt: new Date().toISOString(),
    checks: {},
    screenshots: [],
  }
  function assert(condition, message) {
    if (!condition) throw new Error(message)
  }
  const consoleErrors = []
  const pageErrors = []
  const externalRequests = []
  const syntheticRedirect =
    'http://127.0.0.1:1455/auth/callback?code=fixture-only&state=fixture'
  page.setDefaultTimeout(7000)
  const onConsole = (message) => {
    if (
      message.type() === 'error' &&
      !/(?:status of )?(?:401|500|503)\b/.test(message.text())
    )
      consoleErrors.push(message.text())
  }
  const onPageError = (error) => pageErrors.push(error.message)
  const onRequest = (request) => {
    const url = new URL(request.url())
    if (
      url.pathname.includes('/__fixtures/never-open') ||
      url.port === '1455' ||
      (url.origin !== 'http://127.0.0.1:5171' && url.origin !== FIXTURE)
    )
      externalRequests.push(url.origin + url.pathname)
  }
  page.on('console', onConsole)
  page.on('pageerror', onPageError)
  page.on('request', onRequest)

  async function fixture(path, method = 'GET', body) {
    const response = await fetch(`${FIXTURE}${path}`, {
      method,
      headers: { 'content-type': 'application/json' },
      body: body === undefined ? undefined : JSON.stringify(body),
    })
    if (!response.ok)
      throw new Error(`fixture ${method} ${path} -> ${response.status}`)
    return response.json()
  }

  async function waitForResponse(method, pathname, status) {
    return page.waitForResponse(
      (response) =>
        response.request().method() === method &&
        new URL(response.url()).pathname === pathname &&
        response.status() === status,
      { timeout: 7000 },
    )
  }

  async function openEdit(endpointId) {
    await page
      .locator(`[data-endpoint-row="${endpointId}"]`)
      .getByRole('button', { name: 'Edit', exact: true })
      .click()
    const dialog = page.getByRole('dialog').last()
    await dialog.waitFor({ state: 'visible' })
    return dialog
  }

  let dialog = await openEdit('ep-openai-codex')
  await dialog
    .getByText('Not logged in', { exact: true })
    .waitFor({ state: 'visible' })
  await fixture('/__fixtures/faults', 'POST', {
    pathPrefix: '/api/v1/admin/endpoints/ep-openai-codex/oauth/browser',
    method: 'POST',
    status: 500,
    code: 'fixture_oauth_browser_unavailable',
    message: 'fixture browser start failure',
  })
  const browserStartFailure = waitForResponse(
    'POST',
    '/api/v1/admin/endpoints/ep-openai-codex/oauth/browser',
    500,
  )
  await dialog
    .getByRole('button', { name: 'Get authorize link', exact: true })
    .click()
  await browserStartFailure
  const browserStartError = await dialog
    .locator('p.text-destructive')
    .first()
    .innerText()
  assert(
    browserStartError.length > 0,
    'browser login start failure did not render',
  )
  const browserStartSuccess = waitForResponse(
    'POST',
    '/api/v1/admin/endpoints/ep-openai-codex/oauth/browser',
    200,
  )
  await dialog
    .getByRole('button', { name: 'Get authorize link', exact: true })
    .click()
  await browserStartSuccess
  await dialog.getByLabel('Authorize link').waitFor({ state: 'visible' })
  await fixture('/__fixtures/faults', 'POST', {
    pathPrefix:
      '/api/v1/admin/endpoints/ep-openai-codex/oauth/browser/complete',
    method: 'POST',
    status: 503,
    code: 'fixture_oauth_complete_unavailable',
    message: 'fixture browser completion failure',
    delayMs: 500,
  })
  const redirect = dialog.getByLabel('Redirect URL')
  await redirect.fill(syntheticRedirect)
  const redirectMasked = (await redirect.getAttribute('type')) === 'password'
  assert(redirectMasked, 'browser redirect input was not masked')
  const failedComplete = waitForResponse(
    'POST',
    '/api/v1/admin/endpoints/ep-openai-codex/oauth/browser/complete',
    503,
  )
  await dialog
    .getByRole('button', { name: 'Complete login', exact: true })
    .click()
  const dismissalDisabled = await dialog
    .getByRole('button', { name: 'Cancel', exact: true })
    .isDisabled()
  await failedComplete
  const redirectRetained = (await redirect.inputValue()) === syntheticRedirect
  assert(
    dismissalDisabled && redirectRetained,
    'failed browser completion discarded its draft or allowed pending dismissal',
  )
  const successfulComplete = waitForResponse(
    'POST',
    '/api/v1/admin/endpoints/ep-openai-codex/oauth/browser/complete',
    200,
  )
  await dialog
    .getByRole('button', { name: 'Complete login', exact: true })
    .click()
  await successfulComplete
  await dialog
    .getByText('Logged in', { exact: true })
    .waitFor({ state: 'visible' })
  assert(
    externalRequests.length === 0,
    `OAuth flow navigated away from the synthetic fixture: ${JSON.stringify(externalRequests)}`,
  )
  assert(
    !JSON.stringify(report).includes('fixture-only') &&
      !JSON.stringify(report).includes(syntheticRedirect),
    'OAuth redirect code leaked into report',
  )
  report.checks.browserOAuth = {
    startFailureVisible: true,
    completionStatuses: [503, 200],
    redirectMasked,
    redirectDraftRetained: redirectRetained,
    dismissDisabledWhilePending: dismissalDisabled,
    noExternalNavigation: true,
  }
  await dialog.getByRole('button', { name: 'Cancel', exact: true }).click()

  await fixture('/__fixtures/faults', 'POST', {
    pathPrefix: '/api/v1/admin/endpoints/ep-openai-codex/oauth',
    method: 'GET',
    status: 200,
    delayMs: 650,
  })
  const providerStatusRequest = page.waitForRequest(
    (request) =>
      request.method() === 'GET' &&
      new URL(request.url()).pathname ===
        '/api/v1/admin/endpoints/ep-openai-codex/oauth',
  )
  const providerStatusResponse = waitForResponse(
    'GET',
    '/api/v1/admin/endpoints/ep-openai-codex/oauth',
    200,
  )
  dialog = await openEdit('ep-openai-codex')
  await providerStatusRequest
  await dialog.getByLabel('Type').click()
  const typeMenu = page
    .locator('[data-slot="select-content"][data-state="open"]')
    .last()
  await typeMenu.waitFor({ state: 'visible' })
  const openRouterOption = typeMenu
    .locator('[data-slot="select-item"]')
    .filter({ hasText: 'OpenRouter' })
  assert(
    await openRouterOption.isVisible(),
    'OpenRouter provider option was not available',
  )
  await openRouterOption.click()
  const providerTrigger = dialog.getByLabel('Type')
  const providerDuringStatus = (await providerTrigger.innerText()).trim()
  const oauthSectionDuringStatus = await dialog
    .getByRole('region', { name: 'ChatGPT login' })
    .count()
  assert(
    providerDuringStatus.includes('OpenRouter') &&
      oauthSectionDuringStatus === 0,
    `provider selection did not leave the OpenAI OAuth section: provider=${providerDuringStatus} oauthSections=${oauthSectionDuringStatus}`,
  )
  await providerStatusResponse
  const providerAfterStatus = (await providerTrigger.innerText()).trim()
  const oauthSectionAfterStatus = await dialog
    .getByRole('region', { name: 'ChatGPT login' })
    .count()
  const providerChangeBrowserVerified =
    providerAfterStatus.includes('OpenRouter') && oauthSectionAfterStatus === 0
  assert(
    providerChangeBrowserVerified,
    `late OpenAI OAuth status changed the provider draft: provider=${providerAfterStatus} oauthSections=${oauthSectionAfterStatus}`,
  )
  await dialog.getByRole('button', { name: 'Cancel', exact: true }).click()

  await fixture('/__fixtures/faults', 'POST', {
    pathPrefix: '/api/v1/admin/endpoints/ep-openai-codex/oauth',
    method: 'GET',
    status: 200,
    delayMs: 650,
  })
  const endpointSwitchStatusRequest = page.waitForRequest(
    (request) =>
      request.method() === 'GET' &&
      new URL(request.url()).pathname ===
        '/api/v1/admin/endpoints/ep-openai-codex/oauth',
  )
  const endpointSwitchStatusResponse = waitForResponse(
    'GET',
    '/api/v1/admin/endpoints/ep-openai-codex/oauth',
    200,
  )
  dialog = await openEdit('ep-openai-codex')
  await endpointSwitchStatusRequest
  await dialog.getByRole('button', { name: 'Cancel', exact: true }).click()
  dialog = await openEdit('ep-openrouter')
  await endpointSwitchStatusResponse
  const endpointDraftCurrent = (
    await dialog.getByLabel('Type').innerText()
  ).includes('OpenRouter')
  assert(
    endpointDraftCurrent,
    'stale OAuth status overwrote the next endpoint draft',
  )
  report.checks.oauthGenerationGuards = {
    providerChangeBrowserVerified,
    providerDuringStatus: providerDuringStatus.includes('OpenRouter'),
    oauthSectionRemoved: oauthSectionAfterStatus === 0,
    endpointSwitchRetained: endpointDraftCurrent,
  }
  await dialog.getByRole('button', { name: 'Cancel', exact: true }).click()

  report.checks.consoleErrors = consoleErrors
  report.checks.pageErrors = pageErrors
  assert(
    pageErrors.length === 0,
    `browser page errors: ${JSON.stringify(pageErrors)}`,
  )
  page.off('console', onConsole)
  page.off('pageerror', onPageError)
  page.off('request', onRequest)
  report.finishedAt = new Date().toISOString()
  return report
}
