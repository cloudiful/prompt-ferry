async page => {
  const BASE = 'http://127.0.0.1:5171'
  const FIXTURE = 'http://127.0.0.1:8789'
  const screenshots = 'e2e/foundation/screenshots'
  const report = {
    runId: `endpoints-${Date.now()}`,
    startedAt: new Date().toISOString(),
    checks: {},
    screenshots: [],
  }
  function assert(condition, message) {
    if (!condition) throw new Error(message)
  }
  const consoleErrors = []
  const pageErrors = []

  page.setDefaultTimeout(7000)
  const onConsole = message => {
    if (message.type() !== 'error') return
    if (/(?:status of )?(?:401|500|503)\b/.test(message.text())) return
    consoleErrors.push(message.text())
  }
  const onPageError = error => pageErrors.push(error.message)
  page.on('console', onConsole)
  page.on('pageerror', onPageError)

  async function fixture(path, method = 'GET', body) {
    const response = await fetch(`${FIXTURE}${path}`, {
      method,
      headers: { 'content-type': 'application/json' },
      body: body === undefined ? undefined : JSON.stringify(body),
    })
    if (!response.ok) throw new Error(`fixture ${method} ${path} -> ${response.status}`)
    return response.json()
  }

  async function waitForResponse(method, pathname, status) {
    return page.waitForResponse(response => {
      const url = new URL(response.url())
      return response.request().method() === method && url.pathname === pathname && (status === undefined || response.status() === status)
    }, { timeout: 7000 })
  }

  async function waitForRouteId(id) {
    await page.locator(`[data-foundation-route-id="${id}"]`).waitFor({ state: 'visible' })
  }

  async function signIn(loginName) {
    await page.getByLabel('Login name').waitFor({ state: 'visible' })
    await page.getByLabel('Login name').fill(loginName)
    await page.getByRole('textbox', { name: 'Password' }).fill('fixture-password')
    await page.getByRole('button', { name: 'Login', exact: true }).click()
    await page.waitForURL(url => new URL(url).pathname === '/api-keys')
    await waitForRouteId('R-API-KEYS')
  }

  async function capture(name) {
    const file = `${screenshots}/${name}.png`
    await page.screenshot({ path: file, fullPage: true })
    report.screenshots.push(file)
  }

  await page.context().clearCookies()
  await fixture('/__fixtures/reset', 'POST')
  await page.setViewportSize({ width: 1440, height: 900 })
  await page.goto(`${BASE}/login`)
  await page.evaluate(() => {
    localStorage.clear()
    localStorage.setItem('prompt-ferry:locale', 'en-US')
    localStorage.setItem('prompt-ferry:theme-mode', 'light')
    localStorage.setItem('prompt-ferry:display-time-zone', 'UTC')
  })
  await page.reload()
  await signIn('operator')
  const operatorLogStart = (await fixture('/__fixtures/log?limit=500')).requests.length
  await page.goto(`${BASE}/endpoints/upstreams`)
  await page.waitForURL(url => new URL(url).pathname === '/api-keys')
  await waitForRouteId('R-API-KEYS')
  const operatorLog = (await fixture('/__fixtures/log?limit=500')).requests.slice(operatorLogStart)
  const deniedEndpointCalls = operatorLog.filter(request => request.path.startsWith('/api/v1/admin/endpoints')).length
  assert(deniedEndpointCalls === 0, `non-admin upstream route made ${deniedEndpointCalls} endpoint API calls`)
  const hiddenUpstreamsLink = await page.locator('a[href="/endpoints/upstreams"]').count() === 0
  assert(hiddenUpstreamsLink, 'non-admin navigation exposed upstreams')
  report.checks.adminDenial = { redirectedToApiKeys: new URL(page.url()).pathname === '/api-keys', hiddenNavigation: hiddenUpstreamsLink, adminApiCalls: deniedEndpointCalls }

  await page.context().clearCookies()
  await fixture('/__fixtures/reset', 'POST')
  await page.goto(`${BASE}/login`)
  await page.evaluate(() => {
    localStorage.clear()
    localStorage.setItem('prompt-ferry:locale', 'en-US')
    localStorage.setItem('prompt-ferry:theme-mode', 'light')
    localStorage.setItem('prompt-ferry:display-time-zone', 'UTC')
  })
  await page.reload()
  await signIn('admin')
  await fixture('/__fixtures/faults', 'POST', {
    pathPrefix: '/api/v1/admin/endpoints',
    method: 'GET',
    status: 200,
    delayMs: 900,
  })
  await page.goto(`${BASE}/endpoints/upstreams`)
  await waitForRouteId('R-ENDPOINTS-UPSTREAMS')
  const loadingVisible = await page.locator('[aria-live="polite"]:visible').first().isVisible()
  const navVisible = await page.locator('a[href="/endpoints/upstreams"]').isVisible()
  assert(loadingVisible && navVisible, 'upstream loading state or admin navigation was missing')
  await page.locator('[data-endpoint-row="ep-minimax-cn"]').waitFor({ state: 'visible' })
  const initialRows = await page.locator('[data-endpoint-row]:visible').evaluateAll(rows => rows.map(row => row.getAttribute('data-endpoint-row')))
  assert(initialRows.length === 10 && new Set(initialRows).size === 10, `initial endpoint page was not ten distinct rows: ${JSON.stringify(initialRows)}`)
  const observedRequests = (await fixture('/__fixtures/log?limit=500')).requests
  const initialRequests = observedRequests.filter(request => request.path === '/api/v1/admin/endpoints' && request.method === 'GET')
  const adminUserOptionsRead = observedRequests.some(request => request.path === '/api/v1/admin/users/options' && request.method === 'GET' && request.status === 200)
  assert(initialRequests.some(request => request.query.first === '0' && request.query.rows === '10'), 'first page query did not use first=0 and rows=10')
  assert(adminUserOptionsRead, 'admin endpoint owner options read was not observed')
  report.checks.adminUserOptionsRead = adminUserOptionsRead
  report.checks.routeAndNavigation = { routeId: 'R-ENDPOINTS-UPSTREAMS', navVisible, initialRowCount: initialRows.length, firstPageQuery: { first: 0, rows: 10 } }
  report.checks.loadingState = loadingVisible
  await capture('endpoints-en-light-1440')

  await page.getByRole('button', { name: 'Next page', exact: true }).click()
  await page.locator('[data-endpoint-row="ep-fixture-10"]').waitFor({ state: 'visible' })
  const secondRows = await page.locator('[data-endpoint-row]:visible').evaluateAll(rows => rows.map(row => row.getAttribute('data-endpoint-row')))
  assert(secondRows.length === 3 && new Set(secondRows).size === 3, `last page did not contain three distinct rows: ${JSON.stringify(secondRows)}`)
  const pageTwoRequest = (await fixture('/__fixtures/log?limit=500')).requests.findLast(request => request.path === '/api/v1/admin/endpoints' && request.method === 'GET' && request.query.first === '10')
  assert(pageTwoRequest?.query.rows === '10', 'second page query was not first=10 rows=10')
  report.checks.pagination = { initialRows: initialRows.length, secondPageRows: secondRows.length, secondPageIds: secondRows, query: pageTwoRequest?.query }
  await page.getByRole('button', { name: 'Previous page', exact: true }).click()
  await page.locator('[data-endpoint-row="ep-minimax-cn"]').waitFor({ state: 'visible' })
  await page.getByLabel('Rows per page').click()
  await page.getByRole('option', { name: '20', exact: true }).click()
  await page.locator('[data-endpoint-row="ep-fixture-10"]').waitFor({ state: 'visible' })
  const pageSizeStored = await page.evaluate(() => localStorage.getItem('prompt-ferry:table-page-size:endpoints'))
  assert(pageSizeStored === '20', `endpoint page size did not persist: ${pageSizeStored}`)
  report.checks.pageSizePersistence = pageSizeStored === '20'

  await page.getByRole('button', { name: 'Refresh', exact: true }).click()
  await page.waitForTimeout(250)
  await fixture('/__fixtures/faults', 'POST', {
    pathPrefix: '/api/v1/admin/endpoints',
    method: 'GET',
    status: 503,
    code: 'fixture_endpoint_list_unavailable',
    message: 'fixture endpoint list failure',
  })
  const listFailure = waitForResponse('GET', '/api/v1/admin/endpoints', 503)
  await page.getByRole('button', { name: 'Refresh', exact: true }).click()
  await listFailure
  const listAlert = page.getByRole('alert').last()
  await listAlert.waitFor({ state: 'visible' })
  const listErrorText = await listAlert.innerText()
  assert(listErrorText.length > 0, 'endpoint list failure did not render an error')
  const listRetry = waitForResponse('GET', '/api/v1/admin/endpoints', 200)
  await page.getByRole('button', { name: 'Refresh', exact: true }).click()
  await listRetry
  await page.locator('[data-endpoint-row="ep-minimax-cn"]').waitFor({ state: 'visible' })
  report.checks.errorState = { visible: true, retainedRows: (await page.locator('[data-endpoint-row]:visible').count()) > 0, retried: true, messagePresent: listErrorText.includes('fixture endpoint list failure') || listErrorText.includes('fixture_endpoint_list_unavailable') }

  async function measureListGeometry() {
    return page.evaluate(() => {
      const visible = element => element.getBoundingClientRect().height > 0
      const rows = Array.from(document.querySelectorAll('[data-endpoint-row]')).filter(visible)
      const cards = Array.from(document.querySelectorAll('[data-endpoint-card]')).filter(visible)
      const table = document.querySelector('[data-slot="table"]')
      const container = document.querySelector('[data-slot="table-container"]')
      const heads = Array.from(document.querySelectorAll('[data-slot="table-head"]')).filter(visible)
      const headNames = heads.map(head => (head.textContent ?? '').trim())
      const urls = Array.from(document.querySelectorAll('[data-endpoint-url]')).filter(visible)
      const metas = Array.from(document.querySelectorAll('[data-endpoint-meta]')).filter(visible)
      const owners = Array.from(document.querySelectorAll('[data-endpoint-owner]')).filter(visible)
      const badgeRows = Array.from(document.querySelectorAll('[data-quota-badges="table"]')).filter(visible)
      const quotaColumnIndex = headNames.indexOf('Usage')
      const lineCount = element => {
        const range = document.createRange()
        range.selectNodeContents(element)
        const tops = new Set(Array.from(range.getClientRects()).map(rect => Math.round(rect.top)))
        return tops.size
      }
      const region = document.querySelector('main') ?? document.body
      const regionText = region.innerText ?? ''
      const headAlignment = heads.map((head, index) => {
        const cell = rows[0] ? Array.from(rows[0].querySelectorAll('td'))[index] : null
        if (!cell) return { name: head.textContent ?? '', delta: null }
        const headBox = head.getBoundingClientRect()
        const cellBox = cell.getBoundingClientRect()
        return {
          name: head.textContent ?? '',
          delta: Math.max(Math.abs(headBox.left - cellBox.left), Math.abs(headBox.right - cellBox.right)),
        }
      })
      const rowQuota = rows.map(row => {
        const cells = Array.from(row.querySelectorAll('td'))
        const quotaCell = quotaColumnIndex >= 0 ? cells[quotaColumnIndex] : null
        const text = quotaCell ? (quotaCell.textContent ?? '').trim() : ''
        return {
          empty: quotaCell === null ? null : text === '',
          hasQuotaButton: row.querySelector('button[aria-label="Token plan usage"]') !== null,
          text,
        }
      })
      const nameCells = [...rows, ...cards]
        .map(entry => entry.querySelector('[data-endpoint-name]'))
        .filter(Boolean)
      return {
        actionHeaderName: headNames.length > 0 ? headNames[headNames.length - 1] : '',
        badgeOverflow: badgeRows.map(badges => {
          const box = badges.getBoundingClientRect()
          const cell = badges.closest('td')
          const cellBox = cell ? cell.getBoundingClientRect() : null
          return {
            overflowsCell: cellBox ? box.right > cellBox.right + 1 : true,
            wrap: getComputedStyle(badges).flexWrap,
          }
        }),
        documentOverflow: document.documentElement.scrollWidth > window.innerWidth,
        headAlignment,
        headNames,
        listTextHasUrl: /https?:\/\//.test(regionText),
        listTextHasRoutingLabels:
          regionText.includes('Automatic by caller protocol') ||
          regionText.includes('Legacy compatible'),
        metaCount: metas.length,
        names: nameCells.map(name => {
          const box = name.getBoundingClientRect()
          const host = name.closest('td, article')
          const hostBox = host ? host.getBoundingClientRect() : null
          return {
            lines: lineCount(name),
            overflowsHost: hostBox ? box.right > hostBox.right + 1 : true,
            text: (name.textContent ?? '').trim(),
            title: name.getAttribute('title') ?? '',
            wraps: getComputedStyle(name).overflowWrap,
          }
        }),
        ownerCount: owners.length,
        quotaColumnIndex,
        rowQuota,
        tableColumns: rows[0] ? Array.from(rows[0].querySelectorAll('td')).length : 0,
        tableScrolls: container ? getComputedStyle(container).overflowX : '',
        urlCount: urls.length,
        visibleCards: cards.length,
        visibleRows: rows.length,
        visibleTable: table ? visible(table) : false,
      }
    })
  }

  const listGeometry = {}
  for (const width of [1440, 1024, 768]) {
    await page.setViewportSize({ width, height: 900 })
    await page.locator('[data-endpoint-row]').first().waitFor({ state: 'visible' })
    listGeometry[`desktop-${width}`] = await measureListGeometry()
  }
  await page.setViewportSize({ width: 390, height: 900 })
  await page.locator('[data-endpoint-card]').first().waitFor({ state: 'visible' })
  listGeometry['mobile-390'] = await measureListGeometry()
  await page.setViewportSize({ width: 1440, height: 900 })
  report.checks.listGeometry = listGeometry

  const idleRow = page.locator('[data-endpoint-row="ep-minimax-cn"]')
  const idleControlCount = await idleRow
    .locator('button[aria-label="Not tested"]')
    .count()
  assert(
    idleControlCount === 0,
    'a row without a test result still renders a test-result control',
  )
  const probeRow = page.locator('[data-endpoint-row="ep-openai-codex"]')
  await probeRow.getByRole('button', { name: 'Test', exact: true }).click()
  const probeResultControl = probeRow.locator('button[aria-label*="HTTP"]')
  await probeResultControl.waitFor({ state: 'visible' })
  const probeResultName = await probeResultControl.getAttribute('aria-label')
  assert(
    (probeResultName ?? '').includes('HTTP'),
    `a row with a test result did not expose its result control: ${probeResultName}`,
  )
  await probeResultControl.click()
  const probePopover = page
    .getByText('HTTP', { exact: false })
    .last()
  await probePopover.waitFor({ state: 'visible' })
  const probePopoverText = await probePopover.innerText()
  assert(
    probePopoverText.includes('HTTP') && probePopoverText.length > 10,
    `the test-result popover did not show the result message: ${probePopoverText}`,
  )
  await page.keyboard.press('Escape')
  report.checks.testResultControl = {
    idleControlAbsent: idleControlCount === 0,
    populatedControlName: probeResultName,
    popoverText: probePopoverText,
  }

  await page.getByRole('button', { name: 'New endpoint', exact: true }).click()
  const dialog = page.getByRole('dialog').last()
  const dialogName = dialog.getByLabel('Name', { exact: true })
  await dialogName.waitFor({ state: 'visible' })
  await dialogName.fill('Fixture dialog geometry endpoint')
  async function waitForStableDialogLayout(width) {
    await page.waitForFunction(
      (expected) => window.innerWidth === expected,
      width,
    )
    await page.evaluate(
      () =>
        new Promise((resolve) => {
          const nodes = document.querySelectorAll(
            '[data-slot="dialog-content"]',
          )
          const node = nodes[nodes.length - 1]
          let previous = null
          let stable = 0
          const step = () => {
            if (!node) {
              resolve(false)
              return
            }
            const rect = node.getBoundingClientRect()
            const maxWidth = getComputedStyle(node).maxWidth
            const unchanged =
              previous !== null &&
              Math.abs(rect.width - previous.width) < 0.5 &&
              Math.abs(rect.x - previous.x) < 0.5 &&
              maxWidth === previous.maxWidth
            stable = unchanged ? stable + 1 : 0
            previous = { width: rect.width, x: rect.x, maxWidth }
            if (stable >= 3) {
              resolve(true)
              return
            }
            requestAnimationFrame(step)
          }
          requestAnimationFrame(step)
        }),
    )
  }
  const dialogGeometry = []
  for (const width of [1440, 1024, 768, 390]) {
    await page.setViewportSize({ width, height: 900 })
    await waitForStableDialogLayout(width)
    await dialogName.waitFor({ state: 'visible' })
    const measured = await dialog.evaluate(node => {
      const box = node.getBoundingClientRect()
      const visible = element => {
        if (element.getBoundingClientRect().height <= 0) return false
        const style = getComputedStyle(element)
        if (
          style.visibility === 'hidden' ||
          style.opacity === '0' ||
          style.pointerEvents === 'none'
        )
          return false
        return element.getAttribute('aria-hidden') !== 'true'
      }
      const controls = Array.from(
        node.querySelectorAll(
          'input, select, [data-slot="select-trigger"], button',
        ),
      ).filter(visible)
      const escaped = controls.filter(element => {
        const rect = element.getBoundingClientRect()
        return rect.left < box.left - 1 || rect.right > box.right + 1
      })
      return {
        viewport: window.innerWidth,
        width: box.width,
        maxWidth: getComputedStyle(node).maxWidth,
        margin: window.innerWidth - box.width,
        scrollWidth: node.scrollWidth,
        clientWidth: node.clientWidth,
        horizontalScroll: node.scrollWidth > node.clientWidth + 1,
        documentOverflow:
          document.documentElement.scrollWidth > window.innerWidth,
        escapedControls: escaped.length,
        escapedControlDetail: escaped.map(element => {
          const rect = element.getBoundingClientRect()
          return {
            tag: element.tagName.toLowerCase(),
            type: element.getAttribute('type'),
            id: element.id,
            ariaLabel: element.getAttribute('aria-label'),
            slot: element.getAttribute('data-slot'),
            left: rect.left,
            right: rect.right,
            width: rect.width,
          }
        }),
        controlCount: controls.length,
      }
    })
    assert(
      measured.horizontalScroll === false,
      `endpoint dialog owned a horizontal scrollbar at ${width}px: ${JSON.stringify(measured)}`,
    )
    assert(
      measured.documentOverflow === false,
      `endpoint dialog overflowed the document at ${width}px: ${JSON.stringify(measured)}`,
    )
    assert(
      measured.escapedControls === 0 && measured.controlCount > 0,
      `an endpoint dialog control escaped the dialog at ${width}px: ${JSON.stringify(measured)}`,
    )
    const expectedWidth =
      width >= 640 ? Math.min(width - 32, 1024) : width - 32
    assert(
      Math.abs(measured.width - expectedWidth) <= 1,
      `endpoint dialog width did not match the declared 64rem layout at ${width}px: ${JSON.stringify(measured)}`,
    )
    if (width >= 1024) {
      const tops = []
      for (const label of ['Scope', 'Type', 'Name', 'Native API']) {
        const controlBox = await dialog
          .getByLabel(label, { exact: true })
          .boundingBox()
        assert(Boolean(controlBox), `${label} was missing at ${width}px`)
        tops.push(controlBox.y)
      }
      const spread = Math.max(...tops) - Math.min(...tops)
      assert(
        spread <= 1,
        `endpoint provider controls did not share one baseline at ${width}px: ${JSON.stringify(tops)}`,
      )
    }
    dialogGeometry.push({ ...measured, expectedWidth })
    if (width === 1440) {
      await capture('endpoints-dialog-en-light-1440')
    }
  }
  await page.setViewportSize({ width: 1440, height: 900 })
  await dialog.getByRole('button', { name: 'Cancel', exact: true }).first().click()
  await dialog.waitFor({ state: 'hidden' })
  report.checks.dialogGeometry = dialogGeometry

  report.checks.consoleErrors = consoleErrors
  report.checks.pageErrors = pageErrors
  assert(pageErrors.length === 0, `browser page errors: ${JSON.stringify(pageErrors)}`)
  page.off('console', onConsole)
  page.off('pageerror', onPageError)
  report.finishedAt = new Date().toISOString()
  return report
}
