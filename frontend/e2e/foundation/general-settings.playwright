async page => {
  const BASE = 'http://127.0.0.1:5188'
  const FIXTURE = 'http://127.0.0.1:8798'
  const context = await page.context().browser().newContext({ serviceWorkers: 'block' })
  page = await context.newPage()
  await context.route('**/*', async route => {
    const url = new URL(route.request().url())
    if (url.origin !== BASE) return route.abort()
    if (!url.pathname.startsWith('/api/')) return route.continue()
    const response = await route.fetch({ url: `${FIXTURE}${url.pathname}${url.search}`, maxRedirects: 0 })
    await route.fulfill({ response })
  })
  const screenshots = 'e2e/foundation/screenshots'
  const startedAt = new Date().toISOString()
  const report = {
    runId: `general-settings-${Date.now()}`,
    startedAt,
    finishedAt: null,
    checks: {},
    scenarios: {
      'R-SETTINGS-GENERAL': {
        'route-render': null,
        'nav-visibility': null,
        'locale-switch': null,
        'theme-switch': null,
      },
    },
    screenshots: [],
    apiFailures: [],
    expectedApiFailures: [],
    expectedConsoleStatusErrors: 0,
    unexpectedRequests: [],
    consoleErrorCount: 0,
    pageErrorCount: 0,
    limitations: [],
  }
  let stage = 'startup'
  let collecting = false

  page.setDefaultTimeout(15000)
  page.on('pageerror', () => report.pageErrorCount++)
  page.on('console', message => {
    if (message.type() !== 'error') return
    // The anonymous bootstrap logs its own expected 401 before sign-in.
    if (/\b401\b/.test(message.text())) {
      report.expectedConsoleStatusErrors =
        (report.expectedConsoleStatusErrors ?? 0) + 1
      return
    }
    report.consoleErrorCount++
  })
  page.on('request', request => {
    const url = new URL(request.url())
    if (!url.pathname.startsWith('/api/')) return
    if (!collecting) return
    // Session bootstrap is not a settings or business read.
    if (
      url.pathname.startsWith('/api/v1/auth/') ||
      url.pathname.startsWith('/api/v1/relay/auth/') ||
      url.pathname === '/api/v1/bridge/status'
    ) {
      return
    }
    report.unexpectedRequests.push(`${request.method()} ${url.pathname}`)
  })
  page.on('response', response => {
    const url = new URL(response.url())
    if (!url.pathname.startsWith('/api/')) return
    if (response.status() < 400) return
    if (response.status() === 401 && url.pathname === '/api/v1/auth/me') {
      report.expectedApiFailures.push('401 GET /api/v1/auth/me')
      return
    }
    report.apiFailures.push(
      `${response.status()} ${response.request().method()} ${url.pathname}`,
    )
  })

  function assert(condition, message) {
    if (!condition) throw new Error(`${stage}: ${message}`)
  }

  async function capture(name) {
    const path = `${screenshots}/${name}.png`
    await page.screenshot({ path, fullPage: true })
    report.screenshots.push(path)
  }

  async function signIn(loginName) {
    await page.goto(`${BASE}/login`)
    const loginNameField = page.getByLabel(/^(Login name|登录名)$/)
    await loginNameField.waitFor({ state: 'visible' })
    await loginNameField.fill(loginName)
    await page
      .getByRole('textbox', { name: /^(Password|密码)$/ })
      .fill('fixture-password')
    await page.getByRole('button', { name: /^(Login|登录)$/ }).click()
    await page.waitForURL(url => new URL(url).pathname === '/api-keys')
  }

  async function signOut() {
    await page.getByRole('button', { name: /Logout|退出登录/ }).click()
    await page.waitForURL(url => new URL(url).pathname === '/login')
  }

  async function openSettings() {
    await page.goto(`${BASE}/settings/general`)
    await page.waitForSelector('[data-foundation-route-id="R-SETTINGS-GENERAL"]')
    await page.waitForTimeout(500)
  }

  async function selectPreference(name, optionName) {
    await page.getByRole('combobox', { name }).click()
    await page.getByRole('option', { name: optionName, exact: true }).click()
    await page.waitForTimeout(250)
  }

  async function storage(key) {
    return page.evaluate(k => window.localStorage.getItem(k), key)
  }

  async function settle() {
    await page.waitForTimeout(900)
    report.unexpectedRequests.length = 0
    collecting = true
  }

  function passed(scenario, evidence) {
    report.scenarios['R-SETTINGS-GENERAL'][scenario] = { passed: true, evidence }
  }

  stage = 'operator-sign-in'
  await page.goto(`${BASE}/login`)
  await page.evaluate(() => {
    window.localStorage.setItem('prompt-ferry:locale', 'en-US')
    window.localStorage.setItem('prompt-ferry:theme-mode', 'light')
  })
  await signIn('operator')
  await page.evaluate(() => {
    window.localStorage.setItem('prompt-ferry:locale', 'en-US')
    window.localStorage.setItem('prompt-ferry:theme-mode', 'light')
    window.localStorage.removeItem('prompt-ferry:display-time-zone')
  })
  await page.reload()
  await page.waitForTimeout(400)

  stage = 'header-actions'
  for (const width of [1440, 390]) {
    await page.setViewportSize({ width, height: 900 })
    await page.goto(`${BASE}/request-records/ai`)
    await page.waitForSelector('[data-foundation-route-id="R-USAGE-AI"]')
    const header = page.locator('header').first()
    await header.getByRole('button', { name: 'Time range' }).waitFor()
    assert((await page.locator('h1').count()) === 1, `AI heading count at ${width}`)
    assert(await header.getByRole('button', { name: 'Records', exact: true }).isVisible(), `records action missing at ${width}`)
    const range = header.getByRole('button', { name: 'Time range' })
    await range.focus()
    await page.keyboard.press('Enter')
    assert(await page.getByRole('button', { name: 'Last 7d' }).isVisible(), `range keyboard action at ${width}`)
    await page.keyboard.press('Escape')
    await page.waitForFunction(() => document.activeElement?.getAttribute('aria-label') === 'Time range')
    const bounds = await header.locator('button:visible').evaluateAll(nodes => nodes.map(node => {
      const rect = node.getBoundingClientRect()
      return { left: rect.left, right: rect.right }
    }))
    assert(bounds.every(rect => rect.left >= 0 && rect.right <= width), `header clipping at ${width}: ${JSON.stringify(bounds)}`)
    assert(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth), `page overflow at ${width}`)
    await page.goto(`${BASE}/api-keys`)
    await page.waitForSelector('[data-foundation-route-id="R-API-KEYS"]')
    const generate = header.getByRole('button', { name: 'Generate key' })
    await generate.focus()
    await page.keyboard.press('Enter')
    await page.getByRole('dialog').waitFor({ state: 'visible' })
    await page.keyboard.press('Escape')
    await page.getByRole('dialog').waitFor({ state: 'hidden' })
    await page.waitForFunction(() => document.activeElement?.getAttribute('aria-label') === 'Generate key').catch(() => {
      throw new Error(`generate key dialog did not restore trigger focus at ${width}px`)
    })
    await page.goto(`${BASE}/settings/general`)
    await page.waitForSelector('[data-foundation-route-id="R-SETTINGS-GENERAL"]')
    assert((await page.locator('h1').count()) === 1, `settings heading count at ${width}`)
    assert(await header.getByRole('button', { name: 'Time range' }).count() === 0, `stale action at ${width}`)
    assert(await header.getByRole('button', { name: 'Language' }).count() === 0, `language action in header at ${width}`)
  }
  await page.setViewportSize({ width: 1440, height: 900 })
  await page.goto(`${BASE}/api-keys`)
  await page.waitForSelector('[data-foundation-route-id="R-API-KEYS"]')
  report.checks.headerActions = { widths: [1440, 390], keyboard: true, focusReturn: true, navigationCleanup: true }

  stage = 'nav-visibility'
  const settingsSection = await page.evaluate(() => {
    const sections = [...document.querySelectorAll('nav > div')]
    const settings = sections.find(section =>
      /Settings/i.test(section.textContent ?? ''),
    )
    return {
      links: [...(settings?.querySelectorAll('a') ?? [])].map(link => ({
        href: link.getAttribute('href'),
        text: (link.textContent ?? '').trim(),
      })),
    }
  })
  assert(
    settingsSection.links.length === 1 &&
      settingsSection.links[0].href === '/settings/general',
    `an ordinary user does not see exactly the general settings link: ${JSON.stringify(settingsSection)}`,
  )
  const operatorNavHrefs = await page.evaluate(() =>
    [...document.querySelectorAll('nav a')].map(link => link.getAttribute('href')),
  )
  for (const adminHref of [
    '/settings/requests',
    '/settings/network',
    '/settings/review',
    '/settings/storage',
    '/settings/cache-alert',
    '/settings/config-archive',
  ]) {
    assert(
      !operatorNavHrefs.includes(adminHref),
      `the ordinary-user nav exposes the admin settings route ${adminHref}`,
    )
  }
  await page.getByRole('link', { name: 'General' }).click()
  await page.waitForSelector('[data-foundation-route-id="R-SETTINGS-GENERAL"]')
  await page.waitForTimeout(400)
  assert(
    (await page.locator('[data-foundation-placeholder]').count()) === 0,
    'the general route still renders the foundation placeholder',
  )
  passed('nav-visibility', 'an ordinary user reaches the general tab from the only settings link it sees')

  stage = 'route-render'
  const cards = await page.locator('[data-settings-card]').evaluateAll(nodes =>
    nodes.map(node => node.getAttribute('data-settings-card')),
  )
  assert(cards.length === 3, `settings cards: expected 3, got ${cards.length}`)
  for (const id of [
    'settings-locale',
    'settings-theme-mode',
    'settings-display-time-zone',
  ]) {
    assert(
      (await page.locator(`#${id}`).count()) === 1,
      `the ${id} control is missing`,
    )
  }
  assert(
    (await page.getByRole('button', { name: 'Save' }).count()) === 0 &&
      (await page.getByRole('button', { name: 'Refresh' }).count()) === 0,
    'the general tab exposes a server save or refresh action',
  )
  assert(
    (await page.getByText(/Affects how times are displayed only/).count()) === 1,
    'the display time zone effect copy is missing',
  )
  const heading = await page.locator('header h1').innerText()
  assert(heading === 'General', `the general tab heading is not localized: ${heading}`)
  await settle()
  report.checks.zeroRequests = { settings: 0, during: 'operator preferences page' }
  await capture('settings-general-en-light-1440')
  passed('route-render', 'three preference cards render with their ids and no server save action')

  stage = 'locale-switch'
  await selectPreference('Language', '中文')
  assert(
    (await page.evaluate(() => document.documentElement.lang)) === 'zh-CN',
    'the language change did not update the document language',
  )
  assert((await storage('prompt-ferry:locale')) === 'zh-CN', 'the locale was not persisted')
  assert(
    (await page.title()).includes('常规'),
    `the page title did not follow the locale: ${await page.title()}`,
  )
  assert(
    (await page.locator('header h1').innerText()) === '常规',
    'the page heading did not follow the locale',
  )
  await page.getByRole('link', { name: 'AI 请求' }).click()
  await page.waitForSelector('[data-foundation-route-id="R-USAGE-AI"]')
  assert(
    (await page.evaluate(() => document.documentElement.lang)) === 'zh-CN',
    'the locale did not survive a route change',
  )
  await page.reload()
  await page.waitForTimeout(600)
  assert(
    (await page.evaluate(() => document.documentElement.lang)) === 'zh-CN',
    'the locale did not survive a reload',
  )
  await openSettings()
  assert(
    (await page.locator('#settings-locale').innerText()).includes('中文'),
    'the language control did not keep the selected locale',
  )
  passed('locale-switch', 'the language preference applied to the document, persisted, and survived navigation and reload')

  stage = 'theme-switch'
  await selectPreference('主题', '暗色')
  assert(
    (await page.evaluate(() => document.documentElement.classList.contains('dark'))) === true,
    'the dark theme did not reach the document element',
  )
  assert(
    (await page.evaluate(() => document.documentElement.style.colorScheme)) === 'dark',
    'the dark theme did not set the color scheme',
  )
  assert((await storage('prompt-ferry:theme-mode')) === 'dark', 'the theme was not persisted')
  await page.reload()
  await page.waitForTimeout(700)
  assert(
    (await page.evaluate(() => document.documentElement.classList.contains('dark'))) === true,
    'the theme did not survive a reload',
  )
  await openSettings()
  passed('theme-switch', 'the theme preference applied to the document, persisted, and survived a reload')

  stage = 'timezone-default'
  const zoneTrigger = page.locator('#settings-display-time-zone')
  const defaultLabel = await zoneTrigger.innerText()
  const browserZone = await page.evaluate(
    () => Intl.DateTimeFormat().resolvedOptions().timeZone,
  )
  assert(
    defaultLabel.includes('自动') && defaultLabel.includes(browserZone),
    `the automatic zone label does not name the browser zone: ${defaultLabel}`,
  )
  report.checks.timeZoneDefault = { label: defaultLabel, browserZone }

  stage = 'timezone-select'
  await zoneTrigger.click()
  const zoneFilter = page.getByRole('combobox', { name: '筛选' })
  await zoneFilter.fill('tokyo')
  await page.waitForTimeout(200)
  const zoneOptions = await page.getByRole('option').allTextContents()
  assert(
    zoneOptions.includes('Asia/Tokyo') && zoneOptions[0].includes('自动'),
    `the filtered zone list is wrong: ${JSON.stringify(zoneOptions)}`,
  )
  assert(
    (await storage('prompt-ferry:display-time-zone')) === null,
    'filtering the zone list rewrote the stored preference',
  )
  await zoneFilter.press('Enter')
  await page.waitForTimeout(400)
  assert(
    (await storage('prompt-ferry:display-time-zone')) === 'Asia/Tokyo',
    'the explicit zone was not persisted',
  )
  assert(
    (await zoneTrigger.innerText()).includes('Asia/Tokyo'),
    'the trigger does not show the explicit zone',
  )
  await page.reload()
  await page.waitForTimeout(600)
  assert(
    (await page.locator('#settings-display-time-zone').innerText()).includes('Asia/Tokyo'),
    'the explicit zone did not survive a reload',
  )
  report.checks.timeZoneSelect = { persisted: 'Asia/Tokyo', filtered: zoneOptions.length }

  stage = 'cross-page-time-zone'
  const listResponse = await page.evaluate(async () => {
    const response = await fetch(
      '/api/v1/admin/request-records?request_category=ai&range=24h&first=0&rows=10',
    )
    return response.json()
  })
  const rawInstant = listResponse.records[0]?.created_at
  assert(typeof rawInstant === 'string', 'the fixture list returned no created_at')
  const formatted = await page.evaluate(
    ({ instant, zone, utc }) => {
      const options = { hour: '2-digit', hour12: false, minute: '2-digit', second: '2-digit' }
      return {
        tokyo: new Intl.DateTimeFormat('zh-CN', { ...options, timeZone: zone }).format(new Date(instant)),
        utc: new Intl.DateTimeFormat('zh-CN', { ...options, timeZone: utc }).format(new Date(instant)),
      }
    },
    { instant: rawInstant, zone: 'Asia/Tokyo', utc: 'UTC' },
  )
  assert(formatted.tokyo !== formatted.utc, 'the Tokyo and UTC renderings are identical for the sampled record')

  collecting = false
  report.unexpectedRequests.length = 0
  await page.goto(`${BASE}/request-records/ai`)
  await page.waitForSelector('[data-foundation-route-id="R-USAGE-AI"]')
  await page.getByRole('button', { name: '记录', exact: true }).click()
  await page.waitForSelector('[data-usage-record-row]')
  await page.waitForTimeout(400)
  const timeCell = await page
    .locator(`[data-usage-record-row="${listResponse.records[0].record_id}"] [data-usage-cell="created_at"]`)
    .innerText()
  assert(
    timeCell.trim() === formatted.tokyo,
    `the records time cell does not use the selected zone: ${timeCell.trim()} vs ${formatted.tokyo}`,
  )
  assert(
    timeCell.trim() !== formatted.utc,
    'the records time cell ignored the selected zone and rendered UTC',
  )
  await page.goto(`${BASE}/settings/general`)
  await page.waitForSelector('[data-foundation-route-id="R-SETTINGS-GENERAL"]')
  await settle()
  assert(
    report.unexpectedRequests.length === 0,
    `the general tab issued a server request on render: ${JSON.stringify(report.unexpectedRequests)}`,
  )
  assert(
    (await page.locator('#settings-display-time-zone').innerText()).includes('Asia/Tokyo'),
    'the general tab lost the zone choice after the cross-page visit',
  )
  assert(
    (await storage('prompt-ferry:display-time-zone')) === 'Asia/Tokyo',
    'the stored zone changed during the cross-page visit',
  )
  report.checks.crossPage = {
    rawInstant,
    rendered: timeCell.trim(),
    expectedTokyo: formatted.tokyo,
    utc: formatted.utc,
    zoneKept: true,
  }

  stage = 'timezone-clear'
  await page.locator('#settings-display-time-zone').click()
  await page.getByRole('combobox', { name: '筛选' }).fill('不对应时区')
  await page.keyboard.press('Escape')
  await page.waitForTimeout(300)
  assert(
    (await page.locator('#settings-display-time-zone').innerText()).includes('Asia/Tokyo'),
    'closing the filtered list without a selection changed the zone',
  )
  await page.locator('#settings-display-time-zone').click()
  await page.getByRole('option', { name: /自动/ }).click()
  await page.waitForTimeout(400)
  assert(
    (await storage('prompt-ferry:display-time-zone')) === 'auto',
    'choosing the automatic zone did not clear the stored preference',
  )
  await page.locator('#settings-display-time-zone').click()
  await page.getByRole('combobox', { name: '筛选' }).fill('tokyo')
  await page.getByRole('combobox', { name: '筛选' }).press('Enter')
  await page.waitForTimeout(400)
  report.checks.timeZoneClear = { clearedToAuto: true, reselected: 'Asia/Tokyo' }

  stage = 'responsive-en'
  await selectPreference('语言', 'English')
  await selectPreference('Theme', 'Light')
  await settle()
  const profile = []
  for (const width of [1440, 1024, 768, 390]) {
    await page.setViewportSize({ width, height: 900 })
    await page.waitForTimeout(300)
    const measured = await page.evaluate(() => {
      const cards = [...document.querySelectorAll('[data-settings-card]')].map(node => {
        const rect = node.getBoundingClientRect()
        return { left: Math.round(rect.left), top: Math.round(rect.top), right: Math.round(rect.right) }
      })
      const controls = [
        'settings-locale',
        'settings-theme-mode',
        'settings-display-time-zone',
      ].map(id => {
        const rect = document.getElementById(id)?.getBoundingClientRect()
        return rect
          ? { id, left: Math.round(rect.left), right: Math.round(rect.right) }
          : { id, left: -1, right: -1 }
      })
      return {
        cards,
        controls,
        documentWidth: document.documentElement.scrollWidth,
        viewport: window.innerWidth,
      }
    })
    assert(
      measured.cards.length === 3,
      `the ${width}px layout does not show three cards`,
    )
    assert(
      measured.documentWidth <= measured.viewport,
      `the general tab overflows horizontally at ${width}px (${measured.documentWidth})`,
    )
    const twoColumns = measured.cards[0].top === measured.cards[1].top
    assert(
      twoColumns === (width >= 640),
      `the card grid column count is wrong at ${width}px`,
    )
    for (const control of measured.controls) {
      assert(
        control.left >= 0 && control.right <= measured.viewport,
        `the ${control.id} control is not reachable at ${width}px`,
      )
    }
    profile.push({ width, twoColumns, documentWidth: measured.documentWidth })
    if (width === 390) await capture('settings-general-en-light-390')
  }
  report.checks.responsive = profile
  await page.setViewportSize({ width: 1440, height: 900 })
  await settle()

  stage = 'responsive-zh'
  await selectPreference('Language', '中文')
  await selectPreference('主题', '暗色')
  await page.waitForTimeout(300)
  for (const width of [1440, 390]) {
    await page.setViewportSize({ width, height: 900 })
    await page.waitForTimeout(300)
    const overflow = await page.evaluate(
      () => document.documentElement.scrollWidth > window.innerWidth,
    )
    assert(!overflow, `the Chinese dark general tab overflows at ${width}px`)
    await capture(`settings-general-zh-dark-${width}`)
  }
  await page.setViewportSize({ width: 1440, height: 900 })

  stage = 'admin-access'
  await signOut()
  await signIn('admin')
  await page.evaluate(() => {
    window.localStorage.setItem('prompt-ferry:locale', 'en-US')
    window.localStorage.setItem('prompt-ferry:theme-mode', 'light')
  })
  await page.goto(`${BASE}/settings/general`)
  await page.waitForSelector('[data-foundation-route-id="R-SETTINGS-GENERAL"]')
  await page.waitForTimeout(400)
  assert(
    (await page.locator('[data-settings-card]').count()) === 3,
    'the admin does not get the general preference cards',
  )
  const adminNavHrefs = await page.evaluate(() =>
    [...document.querySelectorAll('nav a')].map(link => link.getAttribute('href')),
  )
  assert(
    adminNavHrefs.includes('/settings/requests'),
    'the admin nav is missing the admin settings routes',
  )
  await settle()
  report.checks.admin = { cards: 3, adminNavVisible: true }
  await capture('settings-general-admin-en-light-1440')

  stage = 'admin-header-actions'
  collecting = false
  for (const width of [1440, 390]) {
    await page.setViewportSize({ width, height: 900 })
    await page.goto(`${BASE}/endpoints/upstreams`)
    await page.waitForSelector('[data-foundation-route-id="R-ENDPOINTS-UPSTREAMS"]')
    const header = page.locator('header').first()
    assert((await page.locator('h1').count()) === 1, `upstream heading count at ${width}`)
    assert(await header.getByRole('button', { name: 'Refresh' }).isVisible(), `upstream refresh missing at ${width}`)
    const create = header.getByRole('button', { name: 'New endpoint' })
    await create.focus()
    await page.keyboard.press('Enter')
    await page.getByRole('dialog').waitFor({ state: 'visible' })
    await page.keyboard.press('Escape')
    await page.getByRole('dialog').waitFor({ state: 'hidden' })
    await page.waitForFunction(() => document.activeElement?.textContent?.includes('New endpoint'))
    assert(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth), `upstream overflow at ${width}`)
    await page.goto(`${BASE}/settings/requests`)
    await page.waitForSelector('[data-foundation-route-id="R-SETTINGS-REQUESTS"]')
    assert((await page.locator('h1').count()) === 1, `settings subpage heading count at ${width}`)
    assert(await header.locator('#settings-requests-refresh').isVisible(), `settings refresh missing at ${width}`)
    assert((await header.getByRole('button', { name: 'New endpoint' }).count()) === 0, `stale upstream action at ${width}`)
    await page.goto(`${BASE}/relays`)
    await page.waitForSelector('[data-foundation-route-id="R-RELAYS"]')
    const relayCreate = header.getByRole('button', { name: 'New relay' })
    await relayCreate.focus()
    await page.keyboard.press('Enter')
    await page.getByRole('dialog').waitFor({ state: 'visible' })
    await page.keyboard.press('Escape')
    await page.getByRole('dialog').waitFor({ state: 'hidden' })
    await page.waitForFunction(() => document.activeElement?.textContent?.includes('New relay')).catch(() => {
      throw new Error(`relay dialog did not restore trigger focus at ${width}px`)
    })
    await header.getByRole('button', { name: 'Refresh', exact: true }).click()
    for (const [path, route, refresh] of [
      ['/billing', 'R-BILLING', 'Refresh billing'],
      ['/approvals', 'R-APPROVALS', 'Refresh'],
      ['/available-models', 'R-AVAILABLE-MODELS', 'Refresh'],
    ]) {
      await page.goto(`${BASE}${path}`)
      await page.waitForSelector(`[data-foundation-route-id="${route}"]`)
      const action = header.getByRole('button', { name: refresh, exact: true })
      await action.waitFor({ state: 'visible' })
      await action.click()
      assert((await page.locator('h1').count()) === 1, `${route} heading count at ${width}`)
      assert(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth), `${route} overflow at ${width}`)
      assert((await header.getByRole('button', { name: 'New relay' }).count()) === 0, `stale relay action on ${route}`)
    }
  }
  report.checks.adminHeaderActions = { widths: [1440, 390], createKeyboard: true, focusReturn: true, navigationCleanup: true, relayCreateAndRefresh: true, billingApprovalsModelsRefresh: true }

  stage = 'finish'
  assert(
    report.unexpectedRequests.length === 0,
    `the settled preference work issued unexpected requests: ${JSON.stringify(report.unexpectedRequests)}`,
  )
  report.checks.settingsApiRequests = 0
  report.checks.officialPendingRoutes = 0
  report.limitations.push(
    'Evidence is synthetic-fixture rendered UI, document state and local storage behavior; there is no server-side preference or live session claim.',
    'The general tab owns no server read or write, so its proof is the rendered state plus the empty request ledger rather than an API assertion.',
  )
  report.checks.limitations = report.limitations
  report.finishedAt = new Date().toISOString()
  return report
}
