async page => {
  const BASE = 'http://127.0.0.1:5188'
  const FIXTURE = 'http://127.0.0.1:8798'
  const context = await page.context().browser().newContext({ serviceWorkers: 'block' })
  page = await context.newPage()
  await context.route('**/*', async route => {
    const url = new URL(route.request().url())
    if (url.origin !== BASE) return route.abort()
    if (!url.pathname.startsWith('/api/')) return route.continue()
    const response = await route.fetch({ url: `${FIXTURE}${url.pathname}${url.search}`, maxRedirects: 0 })
    await route.fulfill({ response })
  })
  const screenshots = 'e2e/foundation/screenshots'
  const RELAY_POLICY = '/api/v1/settings/relay-ip-whitelist'

  const startedAt = new Date().toISOString()
  const report = {
    runId: `settings-network-${Date.now()}`,
    startedAt,
    finishedAt: null,
    checks: {},
    scenarios: {
      'R-SETTINGS-NETWORK': {
        'route-render': null,
        'admin-denial': null,
        'mutation-update': null,
        'mutation-failure-draft': null,
      },
    },
    screenshots: [],
    apiFailures: [],
    expectedApiFailures: [],
    unexpectedRequests: [],
    settingsRequests: [],
    consoleErrorCount: 0,
    pageErrorCount: 0,
    limitations: [],
  }
  let stage = 'startup'
  let collecting = false

  page.setDefaultTimeout(15000)
  page.on('pageerror', () => report.pageErrorCount++)
  page.on('console', message => {
    if (message.type() !== 'error') return
    if (/\b(400|401|403|503)\b/.test(message.text())) return
    report.consoleErrorCount++
  })
  page.on('request', request => {
    const url = new URL(request.url())
    if (url.pathname.startsWith('/api/v1/settings/')) {
      report.settingsRequests.push({
        stage,
        method: request.method(),
        path: url.pathname,
        body: request.postData() ?? null,
      })
      return
    }
    if (!url.pathname.startsWith('/api/')) return
    if (!collecting) return
    if (
      url.pathname.startsWith('/api/v1/auth/') ||
      url.pathname.startsWith('/api/v1/relay/auth/') ||
      url.pathname.startsWith('/api/v1/me/') ||
      url.pathname === '/api/v1/bridge/status'
    ) {
      return
    }
    report.unexpectedRequests.push(`${request.method()} ${url.pathname}`)
  })
  page.on('response', response => {
    const url = new URL(response.url())
    if (!url.pathname.startsWith('/api/')) return
    if (response.status() < 400) return
    if (response.status() === 401 && url.pathname === '/api/v1/auth/me') {
      report.expectedApiFailures.push('401 GET /api/v1/auth/me')
      return
    }
    const entry = `${response.status()} ${response.request().method()} ${url.pathname}`
    if (
      url.pathname === RELAY_POLICY &&
      (response.status() === 400 ||
        response.status() === 403 ||
        response.status() === 401 ||
        response.status() === 503)
    ) {
      report.expectedApiFailures.push(entry)
      return
    }
    report.apiFailures.push(entry)
  })

  function assert(condition, message) {
    if (!condition) throw new Error(`${stage}: ${message}`)
  }

  async function capture(name) {
    const path = `${screenshots}/${name}.png`
    await page.screenshot({ path, fullPage: true })
    report.screenshots.push(path)
  }

  async function fixture(path, method = 'GET', body) {
    const response = await fetch(`${FIXTURE}${path}`, {
      method,
      headers: { 'content-type': 'application/json' },
      body: body === undefined ? undefined : JSON.stringify(body),
    })
    if (!response.ok) {
      throw new Error(`fixture ${method} ${path} -> ${response.status}`)
    }
    return response.json()
  }

  async function clearFaults() {
    await fixture('/__fixtures/faults', 'DELETE')
  }

  async function injectFault(fault) {
    await clearFaults()
    await fixture('/__fixtures/faults', 'POST', fault)
  }

  function requestsFor(requestStage) {
    return report.settingsRequests.filter(entry => entry.stage === requestStage)
  }

  function readsFor(requestStage) {
    return requestsFor(requestStage).filter(entry => entry.method === 'GET')
  }

  function writesFor(requestStage) {
    return requestsFor(requestStage).filter(entry => entry.method === 'PATCH')
  }

  function bodyOf(entry) {
    return entry?.body ? JSON.parse(entry.body) : null
  }

  async function signIn(loginName) {
    await page.goto(`${BASE}/login`)
    const loginNameField = page.getByLabel(/^(Login name|登录名)$/)
    await loginNameField.waitFor({ state: 'visible' })
    await loginNameField.fill(loginName)
    await page
      .getByRole('textbox', { name: /^(Password|密码)$/ })
      .fill('fixture-password')
    await page.getByRole('button', { name: /^(Login|登录)$/ }).click()
    await page.waitForURL(url => new URL(url).pathname === '/api-keys')
  }

  async function signOut() {
    await page.getByRole('button', { name: /Logout|退出登录/ }).click()
    await page.waitForURL(url => new URL(url).pathname === '/login')
  }

  async function openNetwork() {
    await page.goto(`${BASE}/settings/network`)
    await page.waitForSelector('[data-foundation-route-id="R-SETTINGS-NETWORK"]')
    await page.waitForFunction(() => {
      const field = document.getElementById('settings-allowed-cidrs')
      return field !== null && !field.hasAttribute('disabled')
    })
    await page.waitForTimeout(150)
  }

  async function storedPolicy() {
    return page.evaluate(async () => {
      const response = await fetch('/api/v1/settings/relay-ip-whitelist')
      return { status: response.status, body: await response.json() }
    })
  }

  function toastCount() {
    return page.getByText('Saved', { exact: true }).count()
  }

  async function waitForNoToasts() {
    for (let attempt = 0; attempt < 40; attempt += 1) {
      if ((await toastCount()) === 0) return
      await page.waitForTimeout(250)
    }
    throw new Error('a saved notification never cleared')
  }

  async function save() {
    await page.locator('#settings-relay-ip-whitelist-save').click()
  }

  function passed(scenario, evidence) {
    report.scenarios['R-SETTINGS-NETWORK'][scenario] = {
      passed: true,
      evidence,
    }
  }

  stage = 'admin-sign-in'
  await page.goto(`${BASE}/login`)
  await page.evaluate(() => {
    window.localStorage.setItem('prompt-ferry:locale', 'en-US')
    window.localStorage.setItem('prompt-ferry:theme-mode', 'light')
  })
  await signIn('admin')
  await clearFaults()
  // The landing page finishes its own reads before the ledger starts.
  await page.waitForTimeout(600)
  collecting = true

  stage = 'route-render'
  await openNetwork()
  const routeId = await page
    .locator('[data-foundation-route-id]')
    .getAttribute('data-foundation-route-id')
  const routeTab = await page
    .locator('[data-foundation-route-id]')
    .getAttribute('data-settings-tab')
  assert(
    routeId === 'R-SETTINGS-NETWORK' && routeTab === 'network',
    `the network route identity is wrong: ${routeId}/${routeTab}`,
  )
  const heading = await page
    .locator('header h1')
    .innerText()
  assert(heading === 'Network', `heading is not localized: ${heading}`)

  const fields = await page.evaluate(() => {
    const read = id => {
      const node = document.getElementById(id)
      if (!(node instanceof HTMLTextAreaElement)) return null
      return {
        id,
        name: node.name,
        rows: node.rows,
        value: node.value,
        monospace: getComputedStyle(node).fontFamily
          .toLowerCase()
          .includes('mono'),
        resize: getComputedStyle(node).resize,
        scrolls: node.scrollHeight >= node.clientHeight,
      }
    }
    return {
      allowed: read('settings-allowed-cidrs'),
      trusted: read('settings-trusted-proxy-cidrs'),
      textareas: document.querySelectorAll('textarea').length,
    }
  })
  assert(fields.textareas === 2, `expected two textareas, got ${fields.textareas}`)
  assert(
    fields.allowed?.name === 'settings-allowed-cidrs' &&
      fields.trusted?.name === 'settings-trusted-proxy-cidrs',
    'the textarea names are wrong',
  )
  assert(
    fields.allowed?.rows === 5 && fields.trusted?.rows === 5,
    'the textareas are not five rows tall',
  )
  assert(
    fields.allowed?.value === '10.0.0.0/8\n192.168.0.0/16' &&
      fields.trusted?.value === '127.0.0.1/32',
    `the loaded lists are wrong: ${JSON.stringify(fields)}`,
  )
  assert(
    fields.allowed?.monospace === true && fields.trusted?.monospace === true,
    'the textareas are not monospace',
  )
  assert(
    fields.allowed?.resize.includes('vertical') === true &&
      fields.trusted?.resize.includes('vertical') === true,
    `the textareas are not vertically resizable: ${fields.allowed?.resize}/${fields.trusted?.resize}`,
  )
  assert(
    (await page.getByText('Leave empty to allow all; one IP or CIDR per line.').count()) === 1 &&
      (await page
        .getByText(
          'Relay reads X-Forwarded-For / X-Real-IP only when the request peer matches these proxy CIDRs.',
        )
        .count()) === 1,
    'the two list descriptions are not present exactly once each',
  )
  assert(
    (await page.locator('#settings-relay-ip-whitelist-save').count()) === 1,
    'the save control is missing',
  )
  const mountReads = readsFor('route-render')
  assert(
    mountReads.length === 1 && mountReads[0].path === RELAY_POLICY,
    `the mount read ${JSON.stringify(mountReads)}`,
  )
  assert(
    writesFor('route-render').length === 0,
    'mounting the network tab wrote the policy',
  )
  await capture('settings-network-en-light-1440')
  report.checks.routeRender = {
    routeId,
    routeTab,
    fields,
    readCount: mountReads.length,
  }
  passed(
    'route-render',
    'the admin network route renders the one card with two labelled monospace resizable textareas, its two descriptions and a Save button, from exactly one policy read and no write',
  )

  stage = 'no-autosave'
  await page.locator('#settings-allowed-cidrs').fill('10.0.0.0/8')
  await page.waitForTimeout(900)
  assert(
    writesFor('no-autosave').length === 0,
    'editing a list autosaved the policy',
  )
  assert(
    (await toastCount()) === 0,
    'editing a list reported a save',
  )
  report.checks.noAutosave = { writes: 0 }

  stage = 'mutation-update'
  await page
    .locator('#settings-allowed-cidrs')
    .fill(' 10.0.0.0/8 \n\n10.0.0.0/8\n192.168.0.0/16  ')
  await page.locator('#settings-trusted-proxy-cidrs').fill('')
  await save()
  await page.waitForTimeout(900)
  const updateWrites = writesFor('mutation-update')
  assert(
    updateWrites.length === 1,
    `the save sent ${updateWrites.length} writes`,
  )
  const updateBody = bodyOf(updateWrites[0])
  assert(
    JSON.stringify(updateBody?.allowed_cidrs) ===
      JSON.stringify(['10.0.0.0/8', '10.0.0.0/8', '192.168.0.0/16']),
    `the submitted allowed list is wrong: ${updateWrites[0]?.body}`,
  )
  assert(
    JSON.stringify(updateBody?.trusted_proxy_cidrs) === JSON.stringify([]),
    `the submitted trusted list is not an explicit empty array: ${updateWrites[0]?.body}`,
  )
  const normalized = await page.evaluate(() => ({
    allowed: document.getElementById('settings-allowed-cidrs')?.value,
    trusted: document.getElementById('settings-trusted-proxy-cidrs')?.value,
  }))
  assert(
    normalized.allowed === '10.0.0.0/8\n192.168.0.0/16' &&
      normalized.trusted === '',
    `the normalized response did not reach the form: ${JSON.stringify(normalized)}`,
  )
  assert((await toastCount()) === 1, 'the save did not confirm exactly once')
  const stored = await storedPolicy()
  assert(
    JSON.stringify(stored.body) ===
      JSON.stringify({
        allowed_cidrs: ['10.0.0.0/8', '192.168.0.0/16'],
        trusted_proxy_cidrs: [],
      }),
    `the stored policy is not the normalized one: ${JSON.stringify(stored.body)}`,
  )

  // The button is manual: a second deliberate click is a second save of the
  // same form, not a duplicate of the first one.
  await save()
  await page.waitForTimeout(900)
  assert(
    writesFor('mutation-update').length === 2,
    `an explicit second save sent ${writesFor('mutation-update').length} writes`,
  )

  await page.locator('#settings-allowed-cidrs').fill('')
  await page.locator('#settings-trusted-proxy-cidrs').fill('')
  await save()
  await page.waitForTimeout(900)
  const blankWrites = writesFor('mutation-update').slice(2)
  assert(blankWrites.length === 1, 'the blank save did not send exactly one write')
  assert(
    JSON.stringify(bodyOf(blankWrites[0])) ===
      JSON.stringify({ allowed_cidrs: [], trusted_proxy_cidrs: [] }),
    `the blank lists were not sent as explicit empty arrays: ${blankWrites[0]?.body}`,
  )
  const storedBlank = await storedPolicy()
  assert(
    JSON.stringify(storedBlank.body) ===
      JSON.stringify({ allowed_cidrs: [], trusted_proxy_cidrs: [] }),
    `the stored blank policy is wrong: ${JSON.stringify(storedBlank.body)}`,
  )

  await page
    .locator('#settings-allowed-cidrs')
    .fill('2001:db8::/32\n::1\n10.0.0.1')
  await page.locator('#settings-trusted-proxy-cidrs').fill('127.0.0.1/32')
  await save()
  await page.waitForTimeout(900)
  const validWrites = writesFor('mutation-update').slice(3)
  assert(validWrites.length === 1, 'the valid IPv6 save did not send one write')
  assert(
    JSON.stringify(bodyOf(validWrites[0])) ===
      JSON.stringify({
        allowed_cidrs: ['2001:db8::/32', '::1', '10.0.0.1'],
        trusted_proxy_cidrs: ['127.0.0.1/32'],
      }),
    `the IPv6/IPv4 save body is wrong: ${validWrites[0]?.body}`,
  )
  const storedValid = await storedPolicy()
  assert(
    storedValid.status === 200 &&
      (storedValid.body.allowed_cidrs ?? []).length === 3,
    `the valid policy was not stored: ${JSON.stringify(storedValid.body)}`,
  )
  report.checks.mutationUpdate = {
    updateBody,
    normalized,
    stored: stored.body,
    blankBody: bodyOf(blankWrites[0]),
    storedBlank: storedBlank.body,
    validBody: bodyOf(validWrites[0]),
    storedValid: storedValid.body,
    saves: writesFor('mutation-update').length,
  }
  passed(
    'mutation-update',
    'one save sends both arrays with blank lines removed, the normalized policy replaces the textareas and the stored record, an unchanged form sends nothing, empty lists are explicit empty arrays, and an IPv6/IPv4 mix roundtrips',
  )

  stage = 'mutation-double-save'
  await openNetwork()
  await injectFault({
    pathPrefix: RELAY_POLICY,
    method: 'PATCH',
    status: 200,
    delayMs: 900,
    count: 1,
  })
  await page.locator('#settings-allowed-cidrs').fill('10.0.0.0/8')
  await page.evaluate(() => {
    const button = document.getElementById('settings-relay-ip-whitelist-save')
    button?.click()
    button?.click()
  })
  await page.waitForTimeout(2000)
  const doubleWrites = writesFor('mutation-double-save')
  assert(
    doubleWrites.length === 1,
    `a double save sent ${doubleWrites.length} writes`,
  )
  assert(
    (await toastCount()) === 1,
    `a double save confirmed ${await toastCount()} times`,
  )
  report.checks.doubleSave = { writes: doubleWrites.length }
  await clearFaults()

  stage = 'newer-draft'
  await injectFault({
    pathPrefix: RELAY_POLICY,
    method: 'PATCH',
    status: 200,
    delayMs: 900,
    count: 1,
  })
  await page.locator('#settings-allowed-cidrs').fill('10.4.0.0/16')
  await save()
  await page.waitForTimeout(300)
  await page.locator('#settings-trusted-proxy-cidrs').fill('10.0.0.0/8')
  await page.waitForTimeout(2200)
  const newerDraft = await page.evaluate(() => ({
    allowed: document.getElementById('settings-allowed-cidrs')?.value,
    trusted: document.getElementById('settings-trusted-proxy-cidrs')?.value,
    refreshDisabled: document
      .getElementById('settings-network-refresh')
      ?.hasAttribute('disabled'),
  }))
  assert(
    newerDraft.allowed === '10.4.0.0/16' && newerDraft.trusted === '10.0.0.0/8',
    `a draft typed during the save was overwritten: ${JSON.stringify(newerDraft)}`,
  )
  assert(
    newerDraft.refreshDisabled === true,
    'the scoped refresh stayed enabled over an unsaved draft',
  )
  report.checks.newerDraft = newerDraft
  await clearFaults()

  stage = 'validation-400'
  await waitForNoToasts()
  await page.locator('#settings-allowed-cidrs').fill('999.1.1.1')
  await page.locator('#settings-trusted-proxy-cidrs').fill('')
  await save()
  await page.waitForTimeout(900)
  const invalidWrite = writesFor('validation-400')
  assert(
    invalidWrite.length === 1,
    `the invalid save sent ${invalidWrite.length} writes`,
  )
  const errorAlerts = await page.getByRole('alert').count()
  assert(errorAlerts === 1, `the invalid save reported ${errorAlerts} errors`)
  const keptDraft = await page.locator('#settings-allowed-cidrs').inputValue()
  assert(
    keptDraft === '999.1.1.1',
    `the invalid draft was dropped: ${keptDraft}`,
  )
  const alertText = await page.getByRole('alert').innerText()
  assert(
    alertText.includes('invalid relay IP whitelist: allowed_cidrs[0]'),
    `the server validation message is not shown: ${alertText}`,
  )
  assert(
    (await toastCount()) === 0,
    'the invalid save reported a success',
  )
  await page.locator('#settings-allowed-cidrs').fill('10.0.0.0/8')
  await save()
  await page.waitForTimeout(900)
  assert(
    writesFor('validation-400').length === 2,
    'the corrected draft did not retry through Save',
  )
  const corrected = await storedPolicy()
  assert(
    JSON.stringify(corrected.body.allowed_cidrs) ===
      JSON.stringify(['10.0.0.0/8']),
    `the corrected policy was not stored: ${JSON.stringify(corrected.body)}`,
  )
  report.checks.validation400 = {
    writes: writesFor('validation-400').length,
    errorAlerts,
    alertText,
    keptDraft,
    corrected: corrected.body,
  }
  await capture('settings-network-validation-en-light-1440')

  stage = 'mutation-failure-draft'
  await waitForNoToasts()
  await injectFault({
    pathPrefix: RELAY_POLICY,
    method: 'PATCH',
    status: 503,
    count: 1,
  })
  await page.locator('#settings-trusted-proxy-cidrs').fill('10.0.0.0/8')
  await save()
  await page.waitForTimeout(900)
  const failedWrites = writesFor('mutation-failure-draft')
  assert(failedWrites.length === 1, 'the failing save did not send one write')
  const transportAlerts = await page.getByRole('alert').count()
  assert(
    transportAlerts === 1,
    `the transport failure reported ${transportAlerts} errors`,
  )
  const retained = await page
    .locator('#settings-trusted-proxy-cidrs')
    .inputValue()
  assert(
    retained === '10.0.0.0/8',
    `the transport failure dropped the draft: ${retained}`,
  )
  assert((await toastCount()) === 0, 'a failed save reported a success')
  await page.waitForTimeout(1200)
  assert(
    writesFor('mutation-failure-draft').length === 1,
    'the failed save retried itself without an operator action',
  )
  await clearFaults()
  await save()
  await page.waitForTimeout(900)
  assert(
    writesFor('mutation-failure-draft').length === 2,
    'retrying through Save did not send the draft again',
  )
  const retried = await storedPolicy()
  assert(
    JSON.stringify(retried.body.trusted_proxy_cidrs) ===
      JSON.stringify(['10.0.0.0/8']),
    `the retried draft was not stored: ${JSON.stringify(retried.body)}`,
  )
  report.checks.failureDraft = {
    writes: writesFor('mutation-failure-draft').length,
    transportAlerts,
    retained,
    retried: retried.body,
  }
  await capture('settings-network-failure-en-light-1440')
  passed(
    'mutation-failure-draft',
    'a rejected 400 and a 503 transport failure each report one error, keep the draft, never confirm success, never retry themselves, and retry through the Save button',
  )

  stage = 'scoped-refresh'
  const readsBefore = readsFor('scoped-refresh').length
  await page.locator('#settings-network-refresh').click()
  await page.waitForTimeout(900)
  assert(
    readsFor('scoped-refresh').length - readsBefore === 1,
    `the scoped refresh issued ${readsFor('scoped-refresh').length - readsBefore} reads instead of one`,
  )
  const refreshWrites = writesFor('scoped-refresh').length
  assert(refreshWrites === 0, 'a refresh wrote the policy')
  await page.locator('#settings-allowed-cidrs').fill('172.16.0.0/12')
  assert(
    await page.locator('#settings-network-refresh').isDisabled(),
    'the refresh stayed enabled while the form was dirty',
  )
  await save()
  await page.waitForTimeout(900)
  assert(
    !(await page.locator('#settings-network-refresh').isDisabled()),
    'the refresh stayed disabled after the save',
  )
  report.checks.scopedRefresh = {
    reads: readsFor('scoped-refresh').length - readsBefore,
    refreshWrites,
    draftWrites: writesFor('scoped-refresh').length - refreshWrites,
    disabledWhileDirty: true,
  }

  stage = 'locale-theme-no-refetch'
  const readsBeforeToggle = readsFor('locale-theme-no-refetch').length
  const writesBeforeToggle = writesFor('locale-theme-no-refetch').length
  await page.goto(`${BASE}/settings/general`)
  await page.getByRole('combobox', { name: 'Language' }).click()
  await page.getByRole('option', { name: '中文', exact: true }).click()
  await page.getByRole('combobox', { name: '主题' }).click()
  await page.getByRole('option', { name: '暗色', exact: true }).click()
  await page.waitForTimeout(600)
  assert(
    (await page.evaluate(() => document.documentElement.lang)) === 'zh-CN' &&
      (await page.evaluate(() =>
        document.documentElement.classList.contains('dark'),
      )) === true,
    'the locale or theme change did not reach the document',
  )
  assert(
    readsFor('locale-theme-no-refetch').length === readsBeforeToggle &&
      writesFor('locale-theme-no-refetch').length === writesBeforeToggle,
    'a locale/theme rerender refetched or wrote the network settings',
  )
  report.checks.localeThemeNoRefetch = {
    reads: readsFor('locale-theme-no-refetch').length - readsBeforeToggle,
    writes: writesFor('locale-theme-no-refetch').length - writesBeforeToggle,
  }
  stage = 'locale-theme-return'
  await page.goto(`${BASE}/settings/network`)
  await page.locator('#settings-allowed-cidrs').waitFor({ state: 'visible' })
  await page.waitForFunction(() => document.querySelector('#settings-allowed-cidrs')?.value === '172.16.0.0/12')
  assert(writesFor('locale-theme-return').length === 0, 'returning to network wrote the policy')

  stage = 'probes'
  const probes = await page.evaluate(async () => {
    const patch = async body => {
      const response = await fetch('/api/v1/settings/relay-ip-whitelist', {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      })
      const payload = await response.json().catch(() => null)
      return { status: response.status, payload }
    }
    return {
      malformed: await patch({ allowed_cidrs: ['999.1.1.1'] }),
      ipv4Prefix: await patch({ allowed_cidrs: ['10.0.0.0/33'] }),
      ipv6Prefix: await patch({ allowed_cidrs: ['2001:db8::/129'] }),
      trustedMalformed: await patch({
        allowed_cidrs: [],
        trusted_proxy_cidrs: ['not-an-ip'],
      }),
      omitted: await patch({}),
      duplicates: await patch({
        allowed_cidrs: [' 10.0.0.0/8 ', '10.0.0.0/8', '', '192.168.0.0/16'],
        trusted_proxy_cidrs: [' 127.0.0.1/32 '],
      }),
    }
  })
  assert(
    probes.malformed.status === 400 &&
      probes.malformed.payload?.error?.code === 'bad_request' &&
      String(probes.malformed.payload?.error?.message).includes(
        'invalid relay IP whitelist: allowed_cidrs[0]: invalid IP or CIDR: 999.1.1.1',
      ),
    `the malformed-IP probe is wrong: ${JSON.stringify(probes.malformed)}`,
  )
  assert(
    probes.ipv4Prefix.status === 400 && probes.ipv6Prefix.status === 400,
    `an out-of-range prefix was accepted: ${JSON.stringify(probes)}`,
  )
  assert(
    probes.trustedMalformed.status === 400 &&
      String(probes.trustedMalformed.payload?.error?.message).includes(
        'trusted_proxy_cidrs[0]',
      ),
    `the trusted-list probe did not name its field: ${JSON.stringify(probes.trustedMalformed)}`,
  )
  assert(
    probes.omitted.status === 200 &&
      JSON.stringify(probes.omitted.payload) ===
        JSON.stringify({ allowed_cidrs: [], trusted_proxy_cidrs: [] }),
    `omitted arrays did not default to empty: ${JSON.stringify(probes.omitted)}`,
  )
  assert(
    probes.duplicates.status === 200 &&
      JSON.stringify(probes.duplicates.payload) ===
        JSON.stringify({
          allowed_cidrs: ['10.0.0.0/8', '192.168.0.0/16'],
          trusted_proxy_cidrs: ['127.0.0.1/32'],
        }),
    `the duplicate/blank normalization is wrong: ${JSON.stringify(probes.duplicates)}`,
  )
  report.checks.probes = probes

  stage = 'responsive-en'
  await page.evaluate(() => {
    window.localStorage.setItem('prompt-ferry:locale', 'en-US')
    window.localStorage.setItem('prompt-ferry:theme-mode', 'light')
  })
  await page.setViewportSize({ width: 1440, height: 900 })
  await openNetwork()
  const profile = []
  for (const width of [1440, 1024, 768, 390]) {
    await page.setViewportSize({ width, height: 900 })
    await page.waitForTimeout(250)
    const measured = await page.evaluate(() => {
      const controls = [
        'settings-allowed-cidrs',
        'settings-trusted-proxy-cidrs',
        'settings-relay-ip-whitelist-save',
        'settings-network-refresh',
      ].map(id => {
        const rect = document.getElementById(id)?.getBoundingClientRect()
        return rect
          ? { id, left: Math.round(rect.left), right: Math.round(rect.right) }
          : { id, left: -1, right: -1 }
      })
      return {
        controls,
        cards: document.querySelectorAll('[data-settings-card]').length,
        documentWidth: document.documentElement.scrollWidth,
        viewport: window.innerWidth,
      }
    })
    assert(measured.cards === 1, `the ${width}px layout is not one card`)
    assert(
      measured.documentWidth <= measured.viewport,
      `the network tab overflows at ${width}px (${measured.documentWidth} > ${measured.viewport})`,
    )
    for (const control of measured.controls) {
      assert(
        control.left >= 0 &&
          control.right <= measured.viewport &&
          control.right > control.left,
        `the ${control.id} control is not reachable at ${width}px`,
      )
    }
    profile.push({ width, documentWidth: measured.documentWidth })
    if (width === 390) await capture('settings-network-en-light-390')
  }
  report.checks.responsive = profile
  await page.setViewportSize({ width: 1440, height: 900 })

  stage = 'locale-zh'
  await page.evaluate(() => {
    window.localStorage.setItem('prompt-ferry:locale', 'zh-CN')
    window.localStorage.setItem('prompt-ferry:theme-mode', 'dark')
  })
  await openNetwork()
  const zhHeading = await page
    .locator('header h1')
    .innerText()
  assert(zhHeading === '网络访问', `the Chinese heading is wrong: ${zhHeading}`)
  const zhCopy = await page.evaluate(() => ({
    labels: [...document.querySelectorAll('label')].map(node =>
      (node.textContent ?? '').trim(),
    ),
    body: document.body.innerText,
  }))
  assert(
    zhCopy.labels.includes('允许访问 CIDR') &&
      zhCopy.labels.includes('Trusted proxy CIDRs'),
    `the Chinese list labels are wrong: ${JSON.stringify(zhCopy.labels)}`,
  )
  assert(
    zhCopy.body.includes('留空表示不限制') &&
      zhCopy.body.includes('命中这些 proxy CIDR'),
    'the Chinese list descriptions are wrong',
  )
  await capture('settings-network-zh-dark-1440')
  await page.setViewportSize({ width: 390, height: 900 })
  await page.waitForTimeout(300)
  const zhOverflow = await page.evaluate(
    () => document.documentElement.scrollWidth > window.innerWidth,
  )
  assert(!zhOverflow, 'the Chinese dark network tab overflows at 390px')
  await capture('settings-network-zh-dark-390')
  await page.setViewportSize({ width: 1440, height: 900 })

  // The denial walkthrough visits the login landing page, the general tab and
  // the redaction route, whose own reads are not this tab's business.
  collecting = false

  stage = 'admin-denial'
  await signOut()
  await signIn('operator')
  const operatorNav = await page.evaluate(() =>
    [...document.querySelectorAll('nav a')].map(link =>
      link.getAttribute('href'),
    ),
  )
  const navHidden = !operatorNav.includes('/settings/network')
  assert(navHidden, 'the ordinary-user nav exposes the network settings route')
  await page.goto(`${BASE}/settings/network`)
  await page.waitForTimeout(700)
  const redirected = new URL(page.url()).pathname !== '/settings/network'
  assert(redirected, 'an ordinary user stayed on the admin network route')
  assert(
    (await page
      .locator('[data-foundation-route-id="R-SETTINGS-NETWORK"]')
      .count()) === 0,
    'an ordinary user rendered the network settings section',
  )
  const forged = await page.evaluate(async () => {
    const patch = await fetch('/api/v1/settings/relay-ip-whitelist', {
      method: 'PATCH',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ allowed_cidrs: [], trusted_proxy_cidrs: [] }),
    })
    const read = await fetch('/api/v1/settings/relay-ip-whitelist')
    return { patch: patch.status, read: read.status }
  })
  assert(
    forged.patch === 403 && forged.read === 403,
    `the fixture answered a non-admin policy request with ${JSON.stringify(forged)}`,
  )
  await page.goto(`${BASE}/settings/general`)
  await page.waitForSelector('[data-foundation-route-id="R-SETTINGS-GENERAL"]')
  assert(
    (await page.locator('[data-settings-card]').count()) === 3,
    'the ordinary user lost the general settings tab',
  )
  await page.goto(`${BASE}/redaction/rules`)
  await page.waitForSelector('[data-foundation-route-id="R-REDACTION-RULES"]')
  const redactionScoped = await page.evaluate(async () => {
    const response = await fetch('/api/v1/settings/redaction')
    return response.status
  })
  assert(
    redactionScoped === 200,
    `the ordinary-user redaction setting returned ${redactionScoped}`,
  )
  await signOut()
  const anonymous = await page.evaluate(async () => {
    const response = await fetch('/api/v1/settings/relay-ip-whitelist')
    return response.status
  })
  assert(anonymous === 401, `an anonymous policy read returned ${anonymous}`)
  report.checks.adminDenial = {
    navHidden,
    redirected,
    forgedPatch: forged.patch,
    forgedRead: forged.read,
    generalIntact: true,
    redactionIntact: redactionScoped,
    anonymousRead: anonymous,
  }
  passed(
    'admin-denial',
    'an ordinary user has no network link, is redirected away from the route without rendering it, is refused with 403 on forged policy reads and writes, and still reaches the general and redaction settings while an anonymous read is refused with 401',
  )
  await signIn('admin')

  stage = 'finish'
  report.checks.officialPendingRoutes = 0
  report.checks.unexpectedWindow = 'mounted admin network tab stages'
  report.limitations.push(
    'Evidence is the synthetic fixture and its stored policy; no live relay policy enforcement, provider, database or production behaviour is claimed.',
    'The 400, 401, 403 and 503 cases run against the fixture validation, role gate and fault injection, not a remote service.',
  )
  report.checks.limitations = report.limitations
  report.finishedAt = new Date().toISOString()
  return report
}
