  "scenarios": {
    "R-SETTINGS-REVIEW": {
      "route-render": {
        "passed": true,
        "evidence": "the admin review route renders one card with all twelve controls, three native disclosure groups, password-only secrets and the PostgreSQL hint, from exactly one read and no write"
      },
      "admin-denial": {
        "passed": true,
        "evidence": "an ordinary user has no review link, is redirected away from the route without rendering it, is refused with 403 on forged review reads and writes, and still reaches the general and redaction settings while an anonymous read is refused with 401"
      },
      "mutation-update": {
        "passed": true,
        "evidence": "one manual save sends the whole object including the assembled webhook, the failure policy changes to fail_open, header values keep their colons, and the stored record matches"
      },
      "mutation-failure-draft": {
        "passed": true,
        "evidence": "a 503 reports one error and keeps the draft without retrying itself, and the Save button resends the same draft successfully"
      }
    }
  },
