  "query": "SELECT\n    endpoint_id AS \"endpoint_id!\",\n    MAX(created_at) AS \"last_activity_at!\"\nFROM request_records\nWHERE endpoint_id = ANY($1)\n  AND created_at >= $2\n  AND created_at >= NOW() - INTERVAL '30 minutes'\nGROUP BY endpoint_id\nORDER BY endpoint_id;\n",
