  "query": "UPDATE mcp_quota_accounts a\nSET reserved_units = a.reserved_units - $2,\n    updated_at = NOW()\nWHERE a.account_id = $1 AND a.reserved_units >= $2\nRETURNING a.account_id, a.group_id, a.period_kind, a.period_start, a.period_end,\n          a.used_units, a.reserved_units\n",
