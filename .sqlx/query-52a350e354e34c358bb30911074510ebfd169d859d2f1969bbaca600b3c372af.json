  "query": "SELECT\n    snapshot_id,\n    endpoint_id,\n    observed_at,\n    plan_type,\n    limit_reached,\n    windows,\n    source,\n    created_at\nFROM chatgpt_quota_snapshots\nWHERE endpoint_id = $1\n  AND ($2::BIGINT IS NULL OR snapshot_id < $2)\nORDER BY snapshot_id DESC\nLIMIT $3;\n",
