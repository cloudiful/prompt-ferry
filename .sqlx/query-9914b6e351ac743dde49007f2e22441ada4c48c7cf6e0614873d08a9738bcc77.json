  "query": "INSERT INTO mcp_oauth_leases (\n    server_id,\n    owner_user_id,\n    connection_id,\n    generation,\n    lease_owner,\n    expires_at,\n    updated_at\n)\nVALUES ($1, $2, $3, $4, $5, $6, NOW())\nON CONFLICT (server_id, owner_user_id) DO UPDATE\nSET lease_owner = EXCLUDED.lease_owner,\n    expires_at = EXCLUDED.expires_at,\n    updated_at = NOW()\nWHERE mcp_oauth_leases.connection_id = EXCLUDED.connection_id\n  AND mcp_oauth_leases.generation = EXCLUDED.generation\n  AND mcp_oauth_leases.expires_at <= NOW()\nRETURNING server_id,\n    owner_user_id,\n    connection_id,\n    generation,\n    lease_owner,\n    expires_at\n",
