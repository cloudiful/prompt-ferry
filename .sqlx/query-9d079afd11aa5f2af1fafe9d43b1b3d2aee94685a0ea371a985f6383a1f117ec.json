  "query": "SELECT\n    event_id,\n    created_at,\n    request_raw_json,\n    response_raw_body\nFROM request_record_raw_payloads\nWHERE created_at >= $1\n  AND created_at < $2\n  AND raw_object_key IS NULL\n  AND (request_raw_json IS NOT NULL OR response_raw_body IS NOT NULL)\nORDER BY created_at ASC, event_id ASC\nLIMIT $3\n",
