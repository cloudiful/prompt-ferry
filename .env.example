# Fresh installation only; see MIGRATING.md before upgrading. Replace placeholders.
PROMPT_FERRY_IMAGE=ghcr.io/cloudiful/prompt-ferry:latest
POSTGRES_DB=prompt_ferry
POSTGRES_USER=prompt_ferry
# Use URL-safe random passwords; change both this and the host URL together.
POSTGRES_PASSWORD=REPLACE-with-random-password
PROMPT_FERRY__DATABASE_URL=postgres://prompt_ferry:REPLACE-with-random-password@127.0.0.1:5432/prompt_ferry
# Required: generate once with openssl rand -base64 32, keep private and back up.
PROMPT_FERRY__MASTER_SECRET=
PROMPT_FERRY__PEER_URLS=[]
# Blank host seed; Compose defaults to redis://valkey:6379. The saved database
# setting wins; a configured but unavailable Valkey fails closed.
PROMPT_FERRY__VALKEY_URL=
PROMPT_FERRY__LOG_LEVEL=info
PROMPT_FERRY__MCP_WARMUP=all
PROMPT_FERRY__MCP_OAUTH_REDIRECT_BASE=
PROMPT_FERRY__UPSTREAM_API_KEY=
PROMPT_FERRY__SHUTDOWN_DRAIN_SECONDS=120
PROMPT_FERRY_PORT=8787
PROMPT_FERRY_POSTGRES_PORT=5432
PROMPT_FERRY_VALKEY_PORT=6379
