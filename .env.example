# Replace OWNER with the GitHub owner before running docker compose.
PROMPT_FERRY_IMAGE=ghcr.io/OWNER/prompt-ferry:latest

POSTGRES_DB=prompt_ferry
POSTGRES_USER=prompt_ferry
# Use an alphanumeric value, for example: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-random-database-password

# Optional worker token for the relay /ws/worker endpoint. Leave empty to allow
# unauthenticated worker connections; anyone who can reach the worker bind can
# then connect as a worker, so use TLS and network isolation in that mode.
# Generate a token with: openssl rand -hex 32
PROMPT_FERRY_WORKER_TOKEN=
PROMPT_FERRY_RELAY__CLIENT_TOKEN=replace-with-a-random-client-token
# Bounded relay response buffering for slow downstream clients.
PROMPT_FERRY_RELAY__RESPONSE_STREAM_BUFFER=256
PROMPT_FERRY_RELAY__RESPONSE_STREAM_MAX_BYTES=16777216
PROMPT_FERRY_RELAY__RESPONSE_STREAM_BACKPRESSURE_TIMEOUT_MS=5000

PROMPT_FERRY_WORKER__BOOTSTRAP_ADMIN_LOGIN=admin
# Optional. When empty and no active user exists yet, a strong random admin
# password is generated and written once to
# <data-root>/prompt-ferry/bootstrap-admin.txt (0600 on Unix); only the file
# path and login are logged.
PROMPT_FERRY_WORKER__BOOTSTRAP_ADMIN_PASSWORD=

# Optional base64-encoded 32-byte worker configuration encryption key used to
# encrypt secrets at rest (legacy name RELAY_SECRET_MASTER_KEY still accepted).
# When unset, a random key is generated and persisted to
# <data-root>/prompt-ferry/worker-config.key (0600 on Unix); back up this file
# or encrypted secrets become unreadable.
PROMPT_FERRY_WORKER__WORKER_CONFIG_ENCRYPTION_KEY=

# Optional upstream API key. A fresh SQLite worker may start without one;
# configure the first endpoint through the Admin console.
PROMPT_FERRY_WORKER__UPSTREAM_API_KEY=

# Optional shared coordination/cache backend. Leave empty to use the selected
# PostgreSQL or SQLite backend with its bounded local fallbacks.
PROMPT_FERRY_WORKER__VALKEY_URL=

# Raw request/response payloads are always stored as compressed per-event
# objects. When a bucket is configured the S3-compatible store is used;
# otherwise payloads fall back to a local directory under the data root.
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_ENDPOINT=
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_BUCKET=
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_REGION=auto
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_ACCESS_KEY=
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_SECRET_KEY=
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_PREFIX=prompt-ferry/raw
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_ALLOW_HTTP=false
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_PATH_STYLE=true
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_LOCAL_DIR=

PROMPT_FERRY_RELAY_PORT=8787
PROMPT_FERRY_WORKER_ADMIN_PORT=8789

# Compose defaults to PostgreSQL. Uncomment and leave empty to select SQLite;
# the same Admin API and authentication remain available.
# PROMPT_FERRY_WORKER__DATABASE_URL=
