# Replace OWNER with the GitHub owner before running docker compose.
PROMPT_FERRY_IMAGE=ghcr.io/OWNER/prompt-ferry:latest

POSTGRES_DB=prompt_ferry
POSTGRES_USER=prompt_ferry
# Use an alphanumeric value, for example: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-random-database-password

# Generate with: openssl rand -hex 32
PROMPT_FERRY_WORKER_TOKEN=replace-with-a-random-worker-token
PROMPT_FERRY_RELAY__CLIENT_TOKEN=replace-with-a-random-client-token

PROMPT_FERRY_WORKER__BOOTSTRAP_ADMIN_LOGIN=admin
PROMPT_FERRY_WORKER__BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-random-admin-password

# Generate with: openssl rand -base64 32
PROMPT_FERRY_WORKER__RELAY_SECRET_MASTER_KEY=replace-with-a-base64-32-byte-key

PROMPT_FERRY_RELAY_PORT=8787
PROMPT_FERRY_WORKER_ADMIN_PORT=8789
