# Copy to .env and replace every placeholder marked REPLACE before starting.
# Values are read as data, never expanded or executed, so a password stays a
# literal string even when it contains $.

PROMPT_FERRY_IMAGE=ghcr.io/cloudiful/prompt-ferry:latest

# Replace the database password in POSTGRES_PASSWORD *and* in DATABASE_URL
# below; the file does not expand variables, so both must be edited together.
# Use a hex value (openssl rand -hex 24) to stay safe in a URL.
POSTGRES_DB=prompt_ferry
POSTGRES_USER=prompt_ferry
POSTGRES_PASSWORD=REPLACE-with-a-random-database-password
DATABASE_URL=postgres://prompt_ferry:REPLACE-with-a-random-database-password@127.0.0.1:5432/prompt_ferry

# Shared coordination and response-affinity cache.
PROMPT_FERRY_WORKER__VALKEY_URL=redis://127.0.0.1:6379

# Raw request/response payloads. The bucket must already exist: RustFS serves
# S3, it does not create buckets for you. Compose starts RustFS with these very
# credentials, so the console login is the access key and secret key here.
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_BUCKET=prompt-ferry-raw
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_REGION=auto
# RustFS access keys are uppercase alphanumeric; the secret is free-form.
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_ACCESS_KEY=REPLACEACCESSKEY0000
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_SECRET_KEY=REPLACE-with-a-random-object-store-secret
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_PREFIX=prompt-ferry/raw
# allow_http must stay true for a plain-HTTP local endpoint.
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_ALLOW_HTTP=true
PROMPT_FERRY_WORKER__RAW_OBJECT_STORE_PATH_STYLE=true

# Required: the token your clients send to the relay. Replace it before start.
PROMPT_FERRY_RELAY__CLIENT_TOKEN=REPLACE-with-a-random-client-token

# Optional. Leave empty to let anyone who can reach the bridge connect as a
# worker, so set it (openssl rand -hex 32) whenever the bridge is reachable.
# The worker token is authoritative for both halves in integrated mode.
PROMPT_FERRY_WORKER__WORKER_TOKEN=

# Optional. Empty and no admin user yet generates a strong password once and
# writes it to <data-root>/prompt-ferry/bootstrap-admin.txt.
PROMPT_FERRY_WORKER__BOOTSTRAP_ADMIN_LOGIN=admin
PROMPT_FERRY_WORKER__BOOTSTRAP_ADMIN_PASSWORD=

# Optional. Empty generates the secret-at-rest key once and stores it in
# <data-root>/prompt-ferry/worker-config.key; back that file up.
PROMPT_FERRY_WORKER__WORKER_CONFIG_ENCRYPTION_KEY=

# Optional upstream key; a first endpoint can also be added in the admin console.
PROMPT_FERRY_WORKER__UPSTREAM_API_KEY=

# Optional. all warms every enabled MCP server at startup, lazy pays per server
# on first request, off skips warmup.
PROMPT_FERRY_WORKER__MCP_WARMUP=all

# Keep this drain below the container stop_grace_period (30s) so requests finish.
PROMPT_FERRY_WORKER__SHUTDOWN_DRAIN_SECONDS=6

PROMPT_FERRY_LOGGING__LEVEL=info

# Published ports. Every service binds loopback only; change them if something
# else already owns the port.
PROMPT_FERRY_RELAY_PORT=8787
PROMPT_FERRY_WORKER_ADMIN_PORT=8789
PROMPT_FERRY_POSTGRES_PORT=5432
PROMPT_FERRY_VALKEY_PORT=6379
PROMPT_FERRY_RUSTFS_PORT=9000
PROMPT_FERRY_RUSTFS_CONSOLE_PORT=9001

# Test-only settings. Read by scripts/ci/with-test-env.sh and
# scripts/ci/run-tests.sh, exported nowhere else; a direct `cargo test` ignores
# this file.
#
# The quota integration tests use exactly one database: the one the URL below
# addresses *and* the one an operator confirmed as host:port/database. Both keys
# must be present and must agree, so pointing the URL at another service — a
# production database included — is refused rather than used. The tests never
# fall back to DATABASE_URL.
# PROMPT_FERRY_QUOTA_TEST_DATABASE_URL=postgres://prompt_ferry_test@127.0.0.1:5432/quota_759_test
# PROMPT_FERRY_QUOTA_TEST_CONFIRMED_TARGET=127.0.0.1:5432/quota_759_test
# Provision the database and apply the repository migrations to it yourself; the
# test runner verifies them but never creates, migrates, or provisions them.
# The one exception is date coverage: request_records is a daily RANGE parent,
# and the preflight requires UTC yesterday/today/tomorrow children before cargo
# starts. Missing days fail read-only unless you explicitly opt in to the
# bounded creation of exactly those children (never drops, never other tables):
# PROMPT_FERRY_QUOTA_TEST_AUTO_CREATE_PARTITIONS=true
# PROMPT_FERRY_TEST_VALKEY_URL=redis://127.0.0.1:6379
# Absolute project-local directory for the SQLite test fixtures, exported as
# TMPDIR; defaults to <repository>/target/test-tmp when unset.
# PROMPT_FERRY_TEST_TMPDIR=target/test-tmp
# Dedicated S3 test target for the real raw-payload integration tests. All
# eight keys travel together: the full runner refuses a partial set, and the
# confirmed target must read exactly endpoint-root/bucket. Focused runs without
# these settings skip the S3 tests explicitly instead of covering less.
# PROMPT_FERRY_TEST_S3_ENDPOINT=http://127.0.0.1:9000
# PROMPT_FERRY_TEST_S3_BUCKET=prompt-ferry-test
# PROMPT_FERRY_TEST_S3_REGION=us-east-1
# PROMPT_FERRY_TEST_S3_ACCESS_KEY=REPLACE-with-a-test-only-access-key
# PROMPT_FERRY_TEST_S3_SECRET_KEY=REPLACE-with-a-test-only-secret-key
# PROMPT_FERRY_TEST_S3_ALLOW_HTTP=true
# PROMPT_FERRY_TEST_S3_PATH_STYLE=true
# PROMPT_FERRY_TEST_S3_CONFIRMED_TARGET=http://127.0.0.1:9000/prompt-ferry-test
